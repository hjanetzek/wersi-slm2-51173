 1835/ B47 :                            .vib2_no_negate:                                ; 1 refs
 1836/ B47 : 56 ED 7F                           AND     R13, #7Fh                       ; mask to 0-127 (half-wave index)
 1837/ B4A : 6B 42                              JR      Z, .vib2_clr_r8                 ; zero sine → skip multiply
 1838/ B4C : 06 ED BF                           ADD     R13, #0BFh                      ; index into sine ROM table at $0FC0-$0FFF
 1839/ B4F : CC 0F                              LD      R12, #0Fh                       ; R12:R13 = $0F:index → ROM lookup
 1840/ B51 : C2 DC                              LDC     R13, @RR12                      ; R13 = sine table value
 1841/ B53 : CC 08                              LD      R12, #08h                       ; 8x8 multiply: sine × reg[$16:$17]
 1842/ B55 : B0 E8                              CLR     ACC_HI
 1843/ B57 : B0 E9                              CLR     ACC_LO
 1844/ B59 :                            .L_0B59:                                ; called from: .L_0B63($0B67)
 1845/ B59 : E0 ED                              RR      R13
