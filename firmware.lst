  245/  AC :                            ; ============================================================
  246/  AC :                            ; === Micro-op: 2× oversample step 1/2 ($AC). Output R15, INC+AND PHASE, R15=waveform[PHASE] ($00AC) ===
  247/  AC :                            ; ============================================================
  248/  AC :                                    ORG     00ACh
  249/  AC :                            micro_2x_step1:
  250/  AC :                            ; 2x oversampled linear scan (Mode A sub 7). Mid pitch.
  251/  AC :                            ; 2 IRQ4 steps per phase advance. T=$80.
  252/  AC :                            ; Step1: output R15, INC+wrap PHASE, fetch new R15.
  253/  AC :                            ; Step2: output R14, interpolate R15=(R15+R14)/2, fetch new R14.
  254/  AC :                            ; R14/R15 are WORKING registers (sample values, not freq step!).
  255/  AC : 08 EF                              LD      PORT0_DAC, WAVE_R15
  256/  AE : 5C B8                              LD      MICRO_OP, #0B8h
  257/  B0 : 7E                                 INC     PHASE
  258/  B1 : 56 E7 3F                           AND     PHASE, #3Fh
  259/  B4 : C7 F7 40                           LD      WAVE_R15, 40h(PHASE)
  260/  B7 : BF                                 IRET
  261/  B8 :                            
  262/  B8 :                            ; ============================================================
  263/  B8 :                            ; === Micro-op: 2× oversample step 2/2 ($B8). Output R14, R15=(R15+R14)/2, R14=waveform[PHASE] ($00B8) ===
  264/  B8 :                            ; ============================================================
  265/  B8 :                                    ORG     00B8h
  266/  B8 :                            micro_2x_step2:
  267/  B8 : 08 EE                              LD      PORT0_DAC, WAVE_R14
  268/  BA : 58 1E                              LD      MICRO_OP, MICRO_OP_NEXT
  269/  BC : 02 FE                              ADD     WAVE_R15, WAVE_R14
  270/  BE : C0 EF                              RRC     WAVE_R15
  271/  C0 : C7 E7 40                           LD      WAVE_R14, 40h(PHASE)
  272/  C3 : BF                                 IRET
  273/  C4 :                            
  274/  C4 :                            ; ============================================================
  275/  C4 :                            ; === Micro-op: 1× direct DDS ($C4). Output waveform[PHASE], PHASE+=R14, AND #$3F ($00C4) ===
  276/  C4 :                            ; ============================================================
  277/  C4 :                                    ORG     00C4h
  278/  C4 :                            micro_1x_dds:
  279/  C4 :                            ; 1x direct DDS (Mode A sub 8-13). High pitch range.
  280/  C4 :                            ; 1 IRQ4 per output. Phase+=R14 per IRQ4. Timer T=R14=$01-$20.
  281/  C4 :                            ; R14 is READ-ONLY freq step constant (set by synthesis_output from T byte).
  282/  C4 :                            ; T and R14 are the same value: timer period = phase step = constant pitch.
  283/  C4 :                            ; 
  284/  C4 :                            ; WARNING: sub 0-7 use R14 as working sample; sub 8+ use R14 as freq step.
  285/  C4 :                            ; Crossing the sub 7/8 boundary mid-note corrupts R14 interpretation.
  286/  C4 :                            ; See WIP_ocean_crash.md.
  287/  C4 : C7 07 40                           LD      PORT0_DAC, 40h(PHASE)
  288/  C7 : 58 1E                              LD      MICRO_OP, MICRO_OP_NEXT
  289/  C9 : 02 7E                              ADD     PHASE, WAVE_R14
  290/  CB : 56 E7 3F                           AND     PHASE, #3Fh
  291/  CE : BF                                 IRET
  292/  CF :                            
  293/  CF :                            ; ============================================================
  294/  CF :                            ; === Micro-op: Variable-duty DDS ($CF→$DA→$E9). Only $CF outputs to DAC ($00CF) ===
  295/  CF :                            ; ============================================================
  296/  CF :                                    ORG     00CFh
  297/  CF :                            micro_duty_dds:
  298/  CF :                            ; Variable-duty DDS (Mode B). PHASE=$40-$7F = waveform table direct.
  299/  CF :                            ; Only $CF outputs to DAC. $DA/$E9 advance phase without output (skip zone).
  300/  CF :                            ; R14 = freq step (added every IRQ4), R15 = skip entry offset.
  301/  CF :                            ; Cycle: $CF scans $40→$7F outputting samples. When PHASE crosses $7F (MI),
  302/  CF :                            ;   SUB R15 adjusts skip entry. $DA/$E9 advance through $80-$FF (no output).
  303/  CF :                            ;   On carry (wrap past $FF): reset PHASE=$40, back to $CF.
  304/  CF :                            ; R15 controls duty cycle: smaller R15 = longer skip = narrower pulse.
  305/  CF : E3 07                              LD      PORT0_DAC, @PHASE
  306/  D1 : 02 7E                              ADD     PHASE, WAVE_R14                 ; advance phase by freq step
  307/  D3 : DB 04                              JR      PL, .L_00D9                     ; PHASE < $80? → stay in output scan
  308/  D5 : 22 7F                              SUB     PHASE, WAVE_R15                 ; crossed $7F: adjust skip entry point by subtracting R15
  309/  D7 : 5C DA                              LD      MICRO_OP, #0DAh                 ; enter skip zone (no more DAC output until reset)
  310/  D9 :                            .L_00D9:                                ; called from: micro_duty_dds($00D3)
  311/  D9 : BF                                 IRET
  312/  DA :                            
  313/  DA :                            ; ============================================================
  314/  DA :                            ; === Micro-op: Duty DDS skip entry ($DA). No output. Advance until carry→$40→$CF ($00DA) ===
  315/  DA :                            ; ============================================================
  316/  DA :                                    ORG     00DAh
  317/  DA :                            micro_duty_skip1:
  318/  DA : 26 E7 81                           SUB     PHASE, #81h                     ; map phase into skip range (SUB $81)
  319/  DD : 02 7E                              ADD     PHASE, WAVE_R14                 ; advance through skip zone
  320/  DF : FB 05                              JR      NC, .skip_continue              ; carry = wrapped past $FF?
  321/  E1 : 7C 40                              LD      PHASE, #40h                     ; yes: reset phase to $40 (waveform table base)
  322/  E3 : 5C CF                              LD      MICRO_OP, #0CFh                 ; back to output scan
  323/  E5 : BF                                 IRET
  324/  E6 :                            .skip_continue:                                ; 1 refs
  325/  E6 : 5C E9                              LD      MICRO_OP, #0E9h                 ; no carry: continue skip
  326/  E8 : BF                                 IRET
  327/  E9 :                            
  328/  E9 :                            ; ============================================================
  329/  E9 :                            ; === Micro-op: Duty DDS skip continue ($E9). No output. Advance until carry→$40→$CF ($00E9) ===
  330/  E9 :                            ; ============================================================
  331/  E9 :                                    ORG     00E9h
  332/  E9 :                            micro_duty_skip2:
  333/  E9 : 02 7E                              ADD     PHASE, WAVE_R14                 ; keep advancing (no DAC output)
  334/  EB : FB 04                              JR      NC, .L_00F1                     ; carry?
  335/  ED : 7C 40                              LD      PHASE, #40h                     ; reset to $40
  336/  EF : 5C CF                              LD      MICRO_OP, #0CFh                 ; back to output scan
  337/  F1 :                            .L_00F1:                                ; called from: micro_duty_skip2($00EB)
  338/  F1 : BF                                 IRET
  339/  F2 :                            
  340/  F2 :                            ; ============================================================
  341/  F2 :                            ; === Micro-op: Programmable-wrap DDS ($F2). Mode C sub 0-10 ($00F2) ===
  342/  F2 :                            ; ============================================================
  343/  F2 :                                    ORG     00F2h
  344/  F2 :                            micro_wrap_dds:
  345/  F2 : C7 07 40                           LD      PORT0_DAC, 40h(PHASE)
  346/  F5 : A2 7F                              CP      PHASE, WAVE_R15
  347/  F7 : FB 03                              JR      NC, .L_00FC
