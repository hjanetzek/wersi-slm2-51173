 2719/ DF8 :                            ; Paths from finalize.envelope and finalize.pitch_overflow join herepitch_output: prepare synthesis_output parameters
 2720/ DF8 :                            ; Inputs: R12 = multiply result high (magnitude), R11 = low byte
 2721/ DF8 :                            ;         R13 = sub mode (from check_underflow/normalize/overflow)
 2722/ DF8 :                            ; R11 bits 7:5 select fractional freq dither pattern from ROM table at $0232.
 2723/ DF8 :                            ; Dither pattern stored in SPH, rotated each IRQ4 for sub-sample pitch accuracy.
 2724/ DF8 : AC 02                              LD      R10, #02h
 2725/ DFA : F0 EB                              SWAP    R11                             ; extract R11 bits 7:5: SWAP nibbles
 2726/ DFC : E0 EB                              RR      R11                             ; RR: bits 7:5 now at 2:0
 2727/ DFE : 56 EB 07                           AND     R11, #07h                       ; isolate 3-bit index (0-7)
 2728/ E01 : 06 EB 32                           ADD     R11, #32h                       ; table base $32 + index
 2729/ E04 : C2 BA                              LDC     R11, @RR10                      ; R11 = ROM[$0232+i] = fractional dither pattern (0-7 of 8 bits set)
 2730/ E06 :                            finalize_output.pitch_output.underflow_shift_entry:                                ; 1 refs
 2731/ E06 :                            ; 8th RR restores PITCH_ENV to original value after
 2732/ E06 :                            ; 7 RR's in pitch_apply/overflow multiply. Needed when ECLK is
 2733/ E06 :                            ; already pending or bus not free (PITCH_ENV not refreshed from Port 1).
 2734/ E06 :                            ; Also entry from underflow_shift cap (R12=$1E, R11=0 = no dither).
 2735/ E06 : E0 1A                              RR      PITCH_ENV
 2736/ E08 :                            ; Calculate synthesis mode table pointer
 2737/ E08 :                            ; R10 = R12 (save magnitude for synthesis_output pitch calc)
 2738/ E08 : A8 EC                              LD      R10, R12
 2739/ E0A : C8 10                              LD      R12, MODE
 2740/ E0C : 56 EC 30                           AND     R12, #30h
 2741/ E0F : 02 DC                              ADD     R13, R12                        ; R13 += mode_offset (\$20=ModeA, \$00=ModeB, \$10=ModeC)
 2742/ E11 : CC 01                              LD      R12, #01h                       ; R12 = 1 (for R13*3+1 computation)
 2743/ E13 : 02 CD                              ADD     R12, R13                        ; R12 = 1 + (sub + mode_offset)
 2744/ E15 : 90 ED                              RL      R13                             ; R13 = (sub + mode_offset) * 2
 2745/ E17 : 02 DC                              ADD     R13, R12                        ; R13 = (sub+mode_offset)*2 + 1 + (sub+mode_offset) = (sub+mode_offset)*3 + 1
 2746/ E19 :                            .f2_nyquist_gate:
 2747/ E19 :                            ; Anti-aliasing gate for Mode C ($F2 wrap DDS).
 2748/ E19 :                            ; T byte (param table byte0) is the phase increment (→ R14).
 2749/ E19 :                            ; If T*2 >= R15 (wrap point), the DDS completes a cycle in < 2 ticks
 2750/ E19 :                            ; — above Nyquist. Gate forces silence to prevent aliased noise.
 2751/ E19 :                            ; The frequency envelope can push pitch up until this gate fires,
 2752/ E19 :                            ; acting as an automatic upper-frequency cutoff.
 2753/ E19 : A6 1E F2                           CP      MICRO_OP_NEXT, #0F2h
 2754/ E1C : EB 0C                              JR      NZ, synthesis_loop_reentry      ; not $F2 → skip gate (only Mode C needs this check)
 2755/ E1E : CC 01                              LD      R12, #01h                       ; R12 = $01 (ROM high byte for param table at $01xx)
 2756/ E20 : C2 CC                              LDC     R12, @RR12                      ; R12 = ROM[$01:R13] = T byte = phase step for new sub-mode
 2757/ E22 : 90 EC                              RL      R12                             ; RL R12 → T * 2 (phase advance in 2 IRQ4 ticks)
 2758/ E24 : A2 CF                              CP      R12, WAVE_R15                   ; T*2 vs R15: C set if T*2 < R15 (at least 2 samples/cycle)
 2759/ E26 : 7B 02                              JR      C, synthesis_loop_reentry       ; T*2 < R15 → below Nyquist, normal operation
 2760/ E28 : DC 2E                              LD      R13, #2Eh                       ; T*2 >= R15 → above Nyquist! R13=$2E = silence (Mode C sub=15, op=$19)
 2761/ E2A :                            
 2762/ E2A :                            ; ============================================================
 2763/ E2A :                            ; === Synthesis loop re-entry (ECLK poll). R13 = param table index for synthesis_output (byte0 offset). Set by pitch_output or synthesis_pass_done ($0E2A) ===
 2764/ E2A :                            ; ============================================================
 2765/ E2A :                                    ORG     0E2Ah
 2766/ E2A :                            synthesis_loop_reentry:                                ; 7 refs
 2767/ E2A : 66 FA 02                           TCM     0FAh, #02h                      ; 0FA=IRQ (interrupt request)  ; test IRQ bit 1 (ECLK pending from COP or LFSR software set)
 2768/ E2D : 6B 33                              JR      Z, synthesis_output             ; ECLK pending → call synthesis_output
 2769/ E2F : 66 E2 04                           TCM     PORT2, #04h                     ; bus check: RARC bit 2 clear = bus available
 2770/ E32 : EB F6                              JR      NZ, synthesis_loop_reentry      ; bus busy → retry
 2771/ E34 : C8 E3                              LD      R12, PORT3                      ; stage 1: read Port 3 for EXSLA bits
 2772/ E36 : E0 EC                              RR      R12                             ; RR: shift EXSLA (bits 2:1) → bits 1:0
 2773/ E38 : F0 EC                              SWAP    R12                             ; SWAP: bits 1:0 → bits 5:4
 2774/ E3A : 56 EC 30                           AND     R12, #30h                       ; keep only bits 5:4 = EXSLA (staging position)
 2775/ E3D : 56 12 CF                           AND     PITCH_HI, #0CFh                 ; clear staging area in PITCH_HI (bits 5:4)
 2776/ E40 : 44 EC 12                           OR      PITCH_HI, R12                   ; merge EXSLA into PITCH_HI bits 5:4 (temporary)
 2777/ E43 : C8 E1                              LD      R12, PORT1                      ; read Port 1 = pitch envelope from master COP
 2778/ E45 : 66 E2 04                           TCM     PORT2, #04h                     ; re-check bus (may have changed during Port 1 read)
 2779/ E48 : EB E0                              JR      NZ, synthesis_loop_reentry      ; bus changed → restart (discard both EXSLA and pitch)
 2780/ E4A : 66 10 80                           TCM     MODE, #80h                      ; MODE bit 7: pitch envelope enable? (bit 7 CLEAR = no pitch tracking)
 2781/ E4D : EB DB                              JR      NZ, synthesis_loop_reentry      ; override set → restart (don't update pitch envelope)
 2782/ E4F : C9 1A                              LD      PITCH_ENV, R12                  ; commit: store pitch envelope (bus verified stable)
 2783/ E51 : C8 12                              LD      R12, PITCH_HI                   ; stage 2: promote EXSLA from bits 5:4 to final bits 7:6
 2784/ E53 : 90 EC                              RL      R12                             ; RL×2: shift bits 5:4 → bits 7:6
 2785/ E55 : 90 EC                              RL      R12
 2786/ E57 : 56 EC C0                           AND     R12, #0C0h                      ; keep only bits 7:6 = EXSLA (final position)
 2787/ E5A : 56 12 3F                           AND     PITCH_HI, #3Fh                  ; clear old bits 7:6 in PITCH_HI
 2788/ E5D : 44 EC 12                           OR      PITCH_HI, R12                   ; commit: merge EXSLA into PITCH_HI bits 7:6
 2789/ E60 : 8B C8                              JR      synthesis_loop_reentry          ; back to poll loop
 2790/ E62 :                            
 2791/ E62 :                            ; ============================================================
 2792/ E62 :                            ; === SYNTHESIS OUTPUT — parameter table read ($0E62) ===
 2793/ E62 :                            ; ============================================================
 2794/ E62 :                                    ORG     0E62h
 2795/ E62 :                            synthesis_output:                                ; 1 refs
 2796/ E62 :                            ; synthesis_output: read param table and switch micro-op mode.
 2797/ E62 :                            ; Inputs:
 2798/ E62 :                            ;   R13 = param table index (from pitch_output, points to Synthesis output param table byte0)
 2799/ E62 :                            ;   R11 = fractional dither pattern (from pitch_output ROM[$0232+i])
 2800/ E62 :                            ;   R10 = multiply result magnitude (from R12 at pitch_output)
 2801/ E62 :                            ; ROM[$01:R13] = 3-byte entry: byte0=T (timer/freq step), byte1=micro-op, byte2=PRE0.
 2802/ E62 :                            ; 
 2803/ E62 :                            ; T byte determines which mode family the new sub belongs to:
 2804/ E62 :                            ;   T >= $40: oversampled modes (8x/4x/2x). Timer runs at T=$80.
 2805/ E62 :                            ;   T <  $40: direct 1x DDS mode ($C4). Timer runs at T=$01-$20.
 2806/ E62 :                            ; 
 2807/ E62 :                            ; UPPER PATH (T>=$40 → oversampled modes, sub 0-7):
 2808/ E62 :                            ;   Reads byte1 (new micro-op: $20/$82/$AC).
 2809/ E62 :                            ;   If reg[$1E]<$C4 (already oversampled): just update reg[$1E]. No R5 change.
 2810/ E62 :                            ;     The running chain picks up new reg[$1E] via LD R5,reg[$1E] at chain end.
 2811/ E62 :                            ;   If reg[$1E]>=$C4 (was 1x DDS): .switch_to_oversampling: DI, R14=R15=waveform[PHASE],
 2812/ E62 :                            ;     force R5 to new oversample chain. Safe transition: R14/R15 primed as samples.
 2813/ E62 :                            ; 
 2814/ E62 :                            ; LOWER PATH (T<$40 → 1x DDS, sub 8+):
 2815/ E62 :                            ;   If reg[$1E]>=$C4 (already 1x DDS): update R14=T (new freq step), update reg[$1E].
 2816/ E62 :                            ;     No R5 change needed — $C4 reloads R5 from reg[$1E] every IRQ4.
 2817/ E62 :                            ;   If reg[$1E]<$C4 (was oversampled): .switch_to_direct_sampling: DI, R14=T, force R5=$C4.
 2818/ E62 :                            ;     Chain transitions are safe: chain runs to last step before reading new reg[$1E].
 2819/ E62 :                            ;     Race only when R5=$19 (micro_init): sets R7=$40, then $C4 reads 40h($40)=CRASH.
 2820/ E62 :                            ;     See WIP_ocean_crash.md.
 2821/ E62 : 56 FA FD                           AND     0FAh, #0FDh                     ; 0FA=IRQ (interrupt request)
 2822/ E65 : CC 01                              LD      R12, #01h                       ; R12=$01: ROM high byte for param table at $01xx
 2823/ E67 : B9 FE                              LD      0FEh, R11                       ; 0FE=SPH (phase accumulator high)  ; save dither pattern to SPH — IRQ4 rotates SPH, carry dithers T0 ±1
 2824/ E69 : C2 BC                              LDC     R11, @RR12                      ; byte0 = T (timer reload for oversampled / freq step for 1x DDS)
 2825/ E6B : DE                                 INC     R13                             ; advance to byte1
 2826/ E6C : A6 EB 40                           CP      R11, #40h                       ; T >= $40? split oversampled vs 1x DDS
 2827/ E6F : 7B 11                              JR      C, .no_oversampling             ; T < $40 → 1x DDS path (sub 8+)
 2828/ E71 :                            .oversampling:
 2829/ E71 : C2 BC                              LDC     R11, @RR12                      ; byte1 = new oversample micro-op ($20/$82/$AC)
 2830/ E73 : A6 1E C4                           CP      MICRO_OP_NEXT, #0C4h            ; currently in 1x DDS mode? (reg[$1E] >= $C4)
 2831/ E76 : 7B 1C                              JR      C, .synthesis_output_common     ; already oversampled → common (no R5 override); was 1x DDS → switch_to_oversampling
 2832/ E78 :                            .switch_to_oversampling:
 2833/ E78 : 8F                                 DI
 2834/ E79 : C7 F7 40                           LD      WAVE_R15, 40h(PHASE)            ; R15 = current waveform sample at PHASE
 2835/ E7C : E8 EF                              LD      WAVE_R14, WAVE_R15              ; R14 = R15 (both primed for oversample chain working registers)
 2836/ E7E : 58 EB                              LD      MICRO_OP, R11                   ; force R5 = new oversample micro-op
 2837/ E80 : 8B 12                              JR      .synthesis_output_common
 2838/ E82 :                            .no_oversampling:                                ; 1 refs
 2839/ E82 : A6 1E C4                           CP      MICRO_OP_NEXT, #0C4h            ; T < $40: currently in 1x DDS? (reg[$1E] >= $C4)
 2840/ E85 : 7B 06                              JR      C, .switch_to_direct_sampling   ; was oversampled → switch_to_direct_sampling; already 1x DDS → update_phase_increment
 2841/ E87 :                            .update_phase_increment:
 2842/ E87 : E8 EB                              LD      WAVE_R14, R11                   ; 1x DDS steady: update R14 = T = new freq step
 2843/ E89 : C2 BC                              LDC     R11, @RR12                      ; byte1 = $C4 (same mode, new freq step only)
 2844/ E8B : 8B 07                              JR      .synthesis_output_common        ; update reg[$1E], R5 unchanged — $C4 reloads from reg[$1E] each IRQ4
 2845/ E8D :                            .switch_to_direct_sampling:                                ; 1 refs
 2846/ E8D : 8F                                 DI
 2847/ E8E : E8 EB                              LD      WAVE_R14, R11                   ; R14 = T = freq step for 1x DDS
 2848/ E90 : C2 BC                              LDC     R11, @RR12                      ; byte1 = $C4 (micro_1x_dds)
 2849/ E92 : 58 EB                              LD      MICRO_OP, R11                   ; force R5=$C4 — if IRQ4 ran micro_init before DI, R7=$40 → CRASH
 2850/ E94 :                            .synthesis_output_common:                                ; 3 refs
 2851/ E94 : B9 1E                              LD      MICRO_OP_NEXT, R11              ; reg[$1E] = new micro-op for next IRQ4 dispatch
 2852/ E96 : 9F                                 EI
 2853/ E97 : DE                                 INC     R13                             ; advance to byte2
 2854/ E98 : C2 CC                              LDC     R12, @RR12                      ; byte2 = PRE0 (timer prescaler: bits 7:2 = divisor, 0=64)
 2855/ E9A : C9 F5                              LD      0F5h, R12                       ; 0F5=PRE0 (timer 0 prescaler)  ; set timer prescaler hardware register
 2856/ E9C :                            ; Set pitch from normalized multiply result (NOT the T byte!).
 2857/ E9C :                            ; R10 = high byte of ACC * PITCH_coeff / 2048, normalized to >= $1E.
 2858/ E9C :                            ; This IS the actual pitch: timer period = R10 * prescaler * 4 ext clocks.
 2859/ E9C :                            ; IRQ4 dithers ±1 via SPH for fractional pitch (3 extra bits from R11).
 2860/ E9C : A9 1D                              LD      TIMER_VAL, R10
 2861/ E9E : 68 EA                              LD      TIMER_LOAD, R10                 ; TIMER_LOAD = R10. IRQ1 writes TIMER_LOAD→T0 to start timer
 2862/ EA0 : 66 FC 01                           TCM     0FCh, #01h                      ; 0FC=FLAGS (flags register)  ; FLAGS bit 0: 0→interpreter (normal), 1→pass_done (first pass only)
 2863/ EA3 : ED 05 8E                           JP      NZ, micro_program_interpreter
 2864/ EA6 :                            .synthesis_pass_done:
 2865/ EA6 :                            ; synthesis_pass_done: runs ONCE at end of initial RAUD setup.
 2866/ EA6 :                            ; OR IMR,#$02: enable IRQ1 (ECLK input on P3.3) — wait for COP's first ECLK.
 2867/ EA6 :                            ; When COP sends the next ECLK pulse, irq1_handler fires:
 2868/ EA6 :                            ;   loads T0 timer, starts T0, enables IRQ4, forces first IRQ4
 2869/ EA6 :                            ;   → micro-op dispatch begins → DAC output starts.
 2870/ EA6 :                            ; After this one-shot, FLAGS bit 0 is cleared → subsequent passes go
 2871/ EA6 :                            ; through micro_program_interpreter instead (normal synthesis loop).
 2872/ EA6 : 46 FB 02                           OR      0FBh, #02h                      ; 0FB=IMR (interrupt mask)
 2873/ EA9 : 9F                                 EI
 2874/ EAA : E6 F8 0C                           LD      0F8h, #0Ch                      ; 0F8=P01M (port 0/1 mode)  ; set P01M to output mode (Port 0 = DAC data, Port 1 = bus)
 2875/ EAD : B6 E2 07                           XOR     PORT2, #07h                     ; toggle Port 2 bus control bits (release slave RAM bus)
 2876/ EB0 : E6 F6 04                           LD      0F6h, #04h                      ; 0F6=P2M (port 2 mode / RARC)  ; set P2M for RARC operation
 2877/ EB3 : 56 FC FE                           AND     0FCh, #0FEh                     ; 0FC=FLAGS (flags register)  ; clear FLAGS bit 0 → next synthesis_output_common goes to interpreter, not here
 2878/ EB6 : B8 FE                              LD      R11, 0FEh                       ; 0FE=SPH (phase accumulator high)  ; restore R11 = dither pattern from SPH
 2879/ EB8 : 26 ED 02                           SUB     R13, #02h                       ; R13 -= 2: undo the 2x INC in synthesis_output → R13 back to byte0 offset
 2880/ EBB : 8D 0E 2A                           JP      synthesis_loop_reentry          ; → synthesis_loop_reentry: poll for ECLK, then call synthesis_output
 2881/ EBE :                            
 2882/ EBE :                            ; ============================================================
 2883/ EBE :                            ; === IRQ1 — Timer Setup (ECLK-triggered) ($0EBE) ===
 2884/ EBE :                            ; ============================================================
 2885/ EBE :                                    ORG     0EBEh
 2886/ EBE :                            irq1_handler:
 2887/ EBE :                            ; irq1_handler: triggered by ECLK (COP envelope clock, ~200Hz per voice).
 2888/ EBE :                            ; LD T0, TIMER_LOAD: load T0 counter with R6 (base pitch value).
 2889/ EBE :                            ; Starts timer T0 which generates IRQ4 at the sample rate.
 2890/ EBE :                            ; Only fires ONCE per ECLK cycle (disables IRQ1, enables IRQ4).
 2891/ EBE :                            ; After IRET, IRQ4 fires immediately (forced pending) → first micro-op runs.
 2892/ EBE : 69 F4                              LD      0F4h, TIMER_LOAD                ; 0F4=T0 (timer 0 counter)
 2893/ EC0 : 46 F1 03                           OR      0F1h, #03h                      ; 0F1=TMR (timer mode register)  ; start T0 timer with T_OUT toggle (TMR bits 1:0 = $03)
 2894/ EC3 : 58 1E                              LD      MICRO_OP, MICRO_OP_NEXT         ; R5 = reg[$1E] — load current micro-op for IRQ4 dispatch
 2895/ EC5 : 56 FB FD                           AND     0FBh, #0FDh                     ; 0FB=IMR (interrupt mask)  ; disable IRQ1 (one-shot: don't re-trigger until next synthesis_pass_done)
 2896/ EC8 : 46 FB 10                           OR      0FBh, #10h                      ; 0FB=IMR (interrupt mask)  ; enable IRQ4 (timer T0 interrupt → micro-op dispatch at sample rate)
 2897/ ECB : 46 FA 10                           OR      0FAh, #10h                      ; 0FA=IRQ (interrupt request)  ; force IRQ4 pending → first micro-op fires immediately after IRET
 2898/ ECE : BF                                 IRET
