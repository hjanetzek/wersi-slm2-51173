 2274/ E08 :                            ; R10 = R12 (save magnitude for synthesis_output pitch calc)
 2275/ E08 : A8 EC                              LD      R10, R12
 2276/ E0A : C8 10                              LD      R12, MODE
 2277/ E0C : 56 EC 30                           AND     R12, #30h
 2278/ E0F : 02 DC                              ADD     R13, R12                        ; R13 += mode_offset (\$20=ModeA, \$00=ModeB, \$10=ModeC)
 2279/ E11 : CC 01                              LD      R12, #01h                       ; R12 = 1 (for R13*3+1 computation)
 2280/ E13 : 02 CD                              ADD     R12, R13                        ; R12 = 1 + (sub + mode_offset)
 2281/ E15 : 90 ED                              RL      R13                             ; R13 = (sub + mode_offset) * 2
 2282/ E17 : 02 DC                              ADD     R13, R12                        ; R13 = (sub+mode_offset)*2 + 1 + (sub+mode_offset) = (sub+mode_offset)*3 + 1
 2283/ E19 :                            .f2_special_check:
 2284/ E19 : A6 1E F2                           CP      MICRO_OP_NEXT, #0F2h            ; $F2 DDS amplitude gate: check if waveform exceeds threshold
 2285/ E1C : EB 0C                              JR      NZ, synthesis_loop_reentry      ; not $F2 → synthesis_loop_reentry with R13 = (sub+mode)*3+1
 2286/ E1E : CC 01                              LD      R12, #01h                       ; re-read param table entry (R12=\$01, R13 from pitch_output)
 2287/ E20 : C2 CC                              LDC     R12, @RR12                      ; R12 = ROM byte (threshold for $F2 gate)
 2288/ E22 : 90 EC                              RL      R12                             ; threshold × 2
 2289/ E24 : A2 CF                              CP      R12, WAVE_R15                   ; compare threshold against WAVE_R15 - $F2 does not modify WAVE_R15, it is a loop marker
 2290/ E26 : 7B 02                              JR      C, synthesis_loop_reentry       ; waveform < threshold → normal (keep running)
 2291/ E28 : DC 2E                              LD      R13, #2Eh                       ; waveform >= threshold → force silence: R13=\$2E = Mode C sub=15 (T=\$00, op=micro_init)
