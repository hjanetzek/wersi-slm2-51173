 1074/ 57B :                            ; === Synthesis loop entry — CLR ACC, add $1D to PROG_CTR, enter interpreter ($057B) ===
 1075/ 57B :                            ; ============================================================
 1076/ 57B :                                    ORG     057Bh
 1077/ 57B :                            synthesis_loop_entry:                                ; 5 refs
 1078/ 57B :                            ; Synthesis loop entry: reset ACC and loop state, prepare PROG_CTR for interpreter.
 1079/ 57B :                            ; Called once during setup (from synthesis_mode_a/b/c), NOT on each ECLK.
 1080/ 57B :                            ; 
 1081/ 57B :                            ; Key action: ADD PROG_CTR, #$1C (+ INC at interpreter_reentry = +$1D total).
 1082/ 57B :                            ; This converts the raw start_offset from micro_raw[0] to a register-file address:
 1083/ 57B :                            ;   Normal programs (offset $02): PROG_CTR = $02 + $1D = $1F → reg[$1F] = first opcode
 1084/ 57B :                            ;   Library programs (offset $2A): PROG_CTR = $2A + $1D = $47 → finalize_output inits ACC
 1085/ 57B :                            ; 
 1086/ 57B :                            ; ACC is CLR'd here ($0000). For library programs, finalize_output overwrites it.
 1087/ 57B :                            ; For normal programs with LFSR, the first opcode should be LOAD to set ACC base.
 1088/ 57B : B0 E8                              CLR     ACC_HI
 1089/ 57D : B0 E9                              CLR     ACC_LO                          ; ACC_LO = 0
 1090/ 57F : B0 18                              CLR     LOOP1_CTR
 1091/ 581 : B0 19                              CLR     LOOP2_CTR
 1092/ 583 : B0 1C                              CLR     BLOCK_CTR
 1093/ 585 : B0 E4                              CLR     ZERO                            ; R4 = 0 (ZERO register, used throughout as constant 0)
 1094/ 587 : 5C 19                              LD      MICRO_OP, #19h                  ; MICRO_OP = $19 (silence micro-op, placeholder until real synthesis starts)
 1095/ 589 : 06 1B 1C                           ADD     PROG_CTR, #1Ch                  ; ADD $1C to PROG_CTR (+ INC at $058C = +$1D converts offset to reg address)
 1096/ 58C :                            interpreter_reentry:                                ; 39 refs
 1097/ 58C : 20 1B                              INC     PROG_CTR
