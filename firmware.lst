  355/ 101 :                            ; === Synthesis output parameter table (R13 = sub*3 + mode*3 + 1) ===
  356/ 101 :                            ;   byte0=T: bit7=1 oversampled (timer only), bit7=0 bits5:0=phase_inc (R14)
