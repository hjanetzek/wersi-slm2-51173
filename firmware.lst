 1876/ B94 :                            ; ============================================================
 1877/ B94 :                            ; === LFSR pitch modulation source (16-bit PRNG + envelope S&H) ($0B94) ===
 1878/ B94 :                            ; ============================================================
 1879/ B94 :                                    ORG     0B94h
 1880/ B94 :                            op_lfsr_noise:
 1881/ B94 :                            ; op_lfsr_noise: 16-bit Galois LFSR pitch modulation
 1882/ B94 :                            ; Micro-program opcode $10, 4-byte instruction: {opcode, running_state, coefficient, counter/lfsr_low}
 1883/ B94 :                            ; Three paths based on BLOCK_CTR (reg[$1C]):
 1884/ B94 :                            ;   counter==0: reload from FREQ[3], do short LFSR, advance if zero
 1885/ B94 :                            ;   counter>0:  decrement, 8-bit LFSR step (high byte only, XOR $1D)
 1886/ B94 :                            ;   counter<0:  full 16-bit LFSR step + pitch envelope S&H from COP
 1887/ B94 :                            ; Exit: differenced noise x coefficient -> R8:R9 -> finalize_output.multiply
 1888/ B94 : A8 1B                              LD      R10, PROG_CTR
 1889/ B96 : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; block counter == 0?
 1890/ B99 : EB 0A                              JR      NZ, .counter_nonzero            ; non-zero → check sign
 1891/ B9B : C7 BA 03                           LD      R11, 03h(R10)                   ; reload block counter from FREQ[3] (LFSR low byte / reload value)
 1892/ B9E : B9 1C                              LD      BLOCK_CTR, R11                  ; block counter = reload value
 1893/ BA0 : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; still zero after reload?
 1894/ BA3 : 8B 04                              JR      .check_zero
 1895/ BA5 :                            .counter_nonzero:                                ; 1 refs
 1896/ BA5 : 5B 0C                              JR      MI, .full_lfsr_step             ; negative → full 16-bit LFSR step
 1897/ BA7 : 00 1C                              DEC     BLOCK_CTR                       ; positive → just decrement counter
 1898/ BA9 :                            .check_zero:                                ; 1 refs
 1899/ BA9 : EB 41                              JR      NZ, .short_lfsr                 ; non-zero → 8-bit LFSR step (short path)
 1900/ BAB : B0 1C                              CLR     BLOCK_CTR                       ; counter exhausted → clear and advance past 4-byte instruction
 1901/ BAD : 06 1B 04                           ADD     PROG_CTR, #04h                  ; advance micro-program counter by 4
 1902/ BB0 : 8D 05 8E                           JP      micro_program_interpreter       ; back to interpreter
 1903/ BB3 :                            .full_lfsr_step:                                ; 1 refs
 1904/ BB3 : 06 EA 03                           ADD     R10, #03h                       ; point to LFSR low byte (FREQ[3])
 1905/ BB6 : 11 EA                              RLC     @R10                            ; rotate low byte left (16-bit LFSR shift)
 1906/ BB8 : 10 11                              RLC     SAVED_HI                        ; rotate high byte left (carry chain from low)
 1907/ BBA : FB 06                              JR      NC, .no_feedback                ; carry set → apply feedback polynomial
 1908/ BBC : B7 EA 87                           XOR     @R10, #87h                      ; XOR low byte with $87 (polynomial feedback)
 1909/ BBF : B6 11 1D                           XOR     SAVED_HI, #1Dh                  ; XOR high byte with $1D (polynomial = $1D87)
 1910/ BC2 :                            .no_feedback:                                ; 1 refs
 1911/ BC2 : 26 EA 03                           SUB     R10, #03h                       ; restore R10 to instruction base
 1912/ BC5 : 46 FA 02                           OR      0FAh, #02h                      ; 0FA=IRQ (interrupt request)  ; set IRQ1 pending (software flag) → forces synthesis_output on next reentry poll
 1913/ BC8 : 66 E2 04                           TCM     PORT2, #04h                     ; check bus state (RARC) for envelope read
 1914/ BCB : EB 27                              JR      NZ, .coeff_exit                 ; bus busy → skip envelope S&H
 1915/ BCD : C8 E3                              LD      R12, PORT3                      ; R12 = Port 3 (EXSLA routing bits)
 1916/ BCF : D8 E1                              LD      R13, PORT1                      ; R13 = Port 1 (pitch envelope from master COP)
 1917/ BD1 : 66 E2 04                           TCM     PORT2, #04h                     ; re-check bus (may have changed during read)
 1918/ BD4 : EB 1E                              JR      NZ, .coeff_exit                 ; bus changed → discard
 1919/ BD6 : 66 10 80                           TCM     MODE, #80h                      ; mode bit 7 = fixed formant? (skip pitch envelope update)
 1920/ BD9 : EB 19                              JR      NZ, .coeff_exit                 ; fixed formant → skip pitch envelope update
 1921/ BDB : D9 1A                              LD      PITCH_ENV, R13                  ; reg[$1A] = pitch envelope value (modulation depth)
 1922/ BDD : F0 EC                              SWAP    R12                             ; extract EXSLA routing from Port 3
 1923/ BDF : 90 EC                              RL      R12
 1924/ BE1 : 56 EC C0                           AND     R12, #0C0h
 1925/ BE4 : 56 12 3F                           AND     PITCH_HI, #3Fh                  ; merge EXSLA bits into reg[$12] (coefficient high bits)
 1926/ BE7 : 44 EC 12                           OR      PITCH_HI, R12
 1927/ BEA : 8B 08                              JR      .coeff_exit
 1928/ BEC :                            .short_lfsr:                                ; 1 refs
 1929/ BEC : CF                                 RCF
 1930/ BED : 10 11                              RLC     SAVED_HI
 1931/ BEF : FB 03                              JR      NC, .coeff_exit                 ; carry → XOR with $1D (8-bit feedback)
 1932/ BF1 : B6 11 1D                           XOR     SAVED_HI, #1Dh
 1933/ BF4 :                            .coeff_exit:                                ; 5 refs
 1934/ BF4 : C7 BA 02                           LD      R11, 02h(R10)                   ; R11 = FREQ[2] (multiply coefficient)
 1935/ BF7 : CC 08                              LD      R12, #08h                       ; 8-bit multiply loop counter
 1936/ BF9 : B0 ED                              CLR     R13                             ; clear accumulator
 1937/ BFB :                            .mul_loop:                                ; 1 refs
 1938/ BFB : E0 EB                              RR      R11                             ; shift coefficient right
 1939/ BFD : FB 03                              JR      NC, .mul_skip                   ; bit clear → skip add
 1940/ BFF : 04 11 ED                           ADD     R13, SAVED_HI                   ; accumulate: R13 += LFSR high byte (reg[$11])
 1941/ C02 :                            .mul_skip:                                ; 1 refs
 1942/ C02 : C0 ED                              RRC     R13                             ; shift result right
 1943/ C04 : CA F5                              DJNZ    R12, .mul_loop                  ; loop 8 times
 1944/ C06 : 12 D4                              ADC     R13, ZERO                       ; round up (2x ADC for bias correction)
 1945/ C08 : 12 D4                              ADC     R13, ZERO
 1946/ C0A : C0 EB                              RRC     R11                             ; R11 = coefficient >> 1
 1947/ C0C : B0 EC                              CLR     R12                             ; clear R12 (sign extension)
 1948/ C0E : 22 DB                              SUB     R13, R11                        ; center: product -= coefficient/2 (zero-mean noise)
 1949/ C10 : 32 C4                              SBC     R12, ZERO
 1950/ C12 : B8 ED                              LD      R11, R13                        ; R11 = centered product (new running state)
 1951/ C14 : AE                                 INC     R10                             ; point to FREQ[1] (old running state)
 1952/ C15 : A7 EA 00                           CP      @R10, #00h                      ; sign of old running state?
 1953/ C18 : 5B 06                              JR      MI, .diff_neg                   ; negative → sign-extend subtraction
 1954/ C1A : 23 DA                              SUB     R13, @R10                       ; delta = new - old (positive old, SBC R4=0)
 1955/ C1C : 32 C4                              SBC     R12, ZERO
 1956/ C1E : 8B 05                              JR      .store_state
 1957/ C20 :                            .diff_neg:                                ; 1 refs
 1958/ C20 : 23 DA                              SUB     R13, @R10                       ; delta = new - old (negative old, SBC #$FF for sign-extend)
 1959/ C22 : 36 EC FF                           SBC     R12, #0FFh
 1960/ C25 :                            .store_state:                                ; 1 refs
 1961/ C25 : F3 AB                              LD      @R10, R11                       ; store new running state to FREQ[1]
 1962/ C27 : 10 ED                              RLC     R13                             ; scale delta left 4 times (×16)
 1963/ C29 : 10 EC                              RLC     R12
 1964/ C2B : 10 ED                              RLC     R13
 1965/ C2D : 10 EC                              RLC     R12
 1966/ C2F : 10 ED                              RLC     R13
 1967/ C31 : 10 EC                              RLC     R12
 1968/ C33 : 10 ED                              RLC     R13
 1969/ C35 : 10 EC                              RLC     R12
 1970/ C37 : 56 ED F0                           AND     R13, #0F0h                      ; mask to upper nibble
 1971/ C3A : 02 9D                              ADD     ACC_LO, R13                     ; R8:R9 += scaled delta (accumulate into ACC)
 1972/ C3C : 12 8C                              ADC     ACC_HI, R12
 1973/ C3E : 8D 0C CC                           JP      finalize_output.multiply        ; → finalize_output.multiply (12×16 multiply with coefficient)
