 2293/ E2A :                            ; ============================================================
 2294/ E2A :                            ; === Synthesis loop re-entry (ECLK poll). R13 = param table index for synthesis_output (byte0 offset). Set by pitch_output or synthesis_pass_done ($0E2A) ===
 2295/ E2A :                            ; ============================================================
 2296/ E2A :                                    ORG     0E2Ah
 2297/ E2A :                            synthesis_loop_reentry:                                ; 7 refs
 2298/ E2A : 66 FA 02                           TCM     0FAh, #02h                      ; 0FA=IRQ (interrupt request)  ; test IRQ bit 1 (ECLK pending from COP or LFSR software set)
 2299/ E2D : 6B 33                              JR      Z, synthesis_output             ; ECLK pending → call synthesis_output
 2300/ E2F : 66 E2 04                           TCM     PORT2, #04h                     ; bus check: RARC bit 2 clear = bus available
 2301/ E32 : EB F6                              JR      NZ, synthesis_loop_reentry      ; bus busy → retry
 2302/ E34 : C8 E3                              LD      R12, PORT3                      ; stage 1: read Port 3 for EXSLA bits
 2303/ E36 : E0 EC                              RR      R12                             ; RR: shift EXSLA (bits 2:1) → bits 1:0
 2304/ E38 : F0 EC                              SWAP    R12                             ; SWAP: bits 1:0 → bits 5:4
 2305/ E3A : 56 EC 30                           AND     R12, #30h                       ; keep only bits 5:4 = EXSLA (staging position)
 2306/ E3D : 56 12 CF                           AND     PITCH_HI, #0CFh                 ; clear staging area in PITCH_HI (bits 5:4)
 2307/ E40 : 44 EC 12                           OR      PITCH_HI, R12                   ; merge EXSLA into PITCH_HI bits 5:4 (temporary)
 2308/ E43 : C8 E1                              LD      R12, PORT1                      ; read Port 1 = pitch envelope from master COP
 2309/ E45 : 66 E2 04                           TCM     PORT2, #04h                     ; re-check bus (may have changed during Port 1 read)
 2310/ E48 : EB E0                              JR      NZ, synthesis_loop_reentry      ; bus changed → restart (discard both EXSLA and pitch)
 2311/ E4A : 66 10 80                           TCM     MODE, #80h                      ; mode bit 7 = fixed formant? (skip pitch envelope update)
 2312/ E4D : EB DB                              JR      NZ, synthesis_loop_reentry      ; override set → restart (don't update pitch envelope)
 2313/ E4F : C9 1A                              LD      PITCH_ENV, R12                  ; commit: store pitch envelope (bus verified stable)
 2314/ E51 : C8 12                              LD      R12, PITCH_HI                   ; stage 2: promote EXSLA from bits 5:4 to final bits 7:6
 2315/ E53 : 90 EC                              RL      R12                             ; RL×2: shift bits 5:4 → bits 7:6
 2316/ E55 : 90 EC                              RL      R12
 2317/ E57 : 56 EC C0                           AND     R12, #0C0h                      ; keep only bits 7:6 = EXSLA (final position)
 2318/ E5A : 56 12 3F                           AND     PITCH_HI, #3Fh                  ; clear old bits 7:6 in PITCH_HI
 2319/ E5D : 44 EC 12                           OR      PITCH_HI, R12                   ; commit: merge EXSLA into PITCH_HI bits 7:6
 2320/ E60 : 8B C8                              JR      synthesis_loop_reentry          ; back to poll loop
