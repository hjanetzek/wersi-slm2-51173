 1783/ AF1 :                            ; ============================================================
 1784/ AF1 :                            ; === Vibrato 2 — sine phase modulation ($90 opcode, 4-byte) ($0AF1) ===
 1785/ AF1 :                            ; ============================================================
 1786/ AF1 :                                    ORG     0AF1h
 1787/ AF1 :                            op_vibrato2:
 1788/ AF1 :                            ; Vibrato 2: sine-wave phase modulation. Opcode $90, 4-byte.
 1789/ AF1 :                            ; Layout: {opcode, saved_R9, phase_increment, freq_param}
 1790/ AF1 :                            ; Phase accumulator in reg[$14:$15], starts at $4000 (quarter-wave).
 1791/ AF1 :                            ; Each iteration: phase += increment, sine ROM lookup at $0FC0-$0FFF,
 1792/ AF1 :                            ; multiply sine × freq_param, sign-correct by quadrant, add to R8:R9.
 1793/ AF1 :                            ; Uses reg[$16:$17] as frequency, reg[$18:$19] as phase step.
 1794/ AF1 :                            ; Creates periodic pitch modulation (vibrato/tremolo).
 1795/ AF1 : 66 10 40                           TCM     MODE, #40h
 1796/ AF4 : 6D 0C CC                           JP      Z, finalize_output.multiply     ; MODE bit 6 clear → skip vibrato
 1797/ AF7 : A8 1B                              LD      R10, PROG_CTR
 1798/ AF9 : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; BLOCK_CTR == 0? (first call)
 1799/ AFC : EB 22                              JR      NZ, .vib2_iteration             ; non-zero → already initialized, go to iteration
 1800/ AFE : AE                                 INC     R10                             ; first call: load loop count from FREQ[1]
 1801/ AFF : E5 EA 1C                           LD      BLOCK_CTR, @R10
 1802/ B02 : A4 E4 1C                           CP      BLOCK_CTR, ZERO
 1803/ B05 : 6D 0C CC                           JP      Z, finalize_output.multiply     ; loop count == 0 → skip
 1804/ B08 :                            .vib2_save_r9:
 1805/ B08 : F3 A9                              LD      @R10, ACC_LO                    ; save R9 to FREQ[1] (overwrite loop count with ACC_LO)
 1806/ B0A : 89 11                              LD      SAVED_HI, ACC_HI                ; save R8 to SAVED_HI (reg[$11])
 1807/ B0C : AE                                 INC     R10
 1808/ B0D : E5 EA 19                           LD      LOOP2_CTR, @R10                 ; reg[$19] = FREQ[2] (phase increment)
 1809/ B10 : B0 18                              CLR     LOOP1_CTR
 1810/ B12 : AE                                 INC     R10                             ; reg[$17] = FREQ[3] (frequency param)
 1811/ B13 : E5 EA 17                           LD      ACC3_LO, @R10
 1812/ B16 : B0 16                              CLR     ACC3_HI                         ; phase accumulator = $4000 (quarter-wave start)
 1813/ B18 : E6 15 00                           LD      ACC2_LO, #00h
 1814/ B1B : E6 14 40                           LD      ACC2_HI, #40h
