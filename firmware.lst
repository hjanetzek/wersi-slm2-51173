 2470/ CA5 :                            ; ============================================================
 2471/ CA5 :                            ; === ACC library init + 12x12 unsigned multiply + pitch envelope + pitch output ($0CA5) ===
 2472/ CA5 :                            ; ============================================================
 2473/ CA5 :                                    ORG     0CA5h
 2474/ CA5 :                            finalize_output:                                ; 1 refs
 2475/ CA5 :                            ; ACC initializer — implements mk1 FREQ library programs.
 2476/ CA5 :                            ; Called by micro_program_interpreter when PROG_CTR >= $3D.
 2477/ CA5 :                            ; 
 2478/ CA5 :                            ; How it works: micro_raw[0] (start_offset byte in FREQ block) serves as
 2479/ CA5 :                            ; both a program offset AND a library address. synthesis_loop_entry adds $1C
 2480/ CA5 :                            ; to PROG_CTR, then interpreter_reentry adds 1 more (total +$1D). When
 2481/ CA5 :                            ; start_offset >= $20, the result is >= $3D, routing here instead of executing
 2482/ CA5 :                            ; bytecodes. This implements the mk1utils ROM library (mk1envlib.c):
 2483/ CA5 :                            ; 
 2484/ CA5 :                            ;   start_offset | PROG_CTR after +$1D | ACC set to | mk1utils name
 2485/ CA5 :                            ;   $20           | $3D (Z shortcut)    | $0000*     | HALT (no envelope)
 2486/ CA5 :                            ;   $22           | $3F                 | $2D00      | ENV=$2CE4; HALT
 2487/ CA5 :                            ;   $26           | $43                 | $4000      | ENV=$4000; HALT
 2488/ CA5 :                            ;   $2A           | $47                 | $8000      | ENV=$8000; HALT
 2489/ CA5 :                            ;   $2E           | $4B                 | $FFFF      | ENV=$FFFF; HALT
 2490/ CA5 :                            ;   * $20 takes Z shortcut → ACC stays $0000 from synthesis_loop_entry CLR
 2491/ CA5 :                            ; 
 2492/ CA5 :                            ; After setting ACC: PROG_CTR reset to $3D = HALT state. All subsequent
 2493/ CA5 :                            ; interpreter calls hit the Z shortcut and go directly to multiply.
 2494/ CA5 :                            ; 
 2495/ CA5 :                            ; Entry: Z flag from 'CP PROG_CTR, #$3D' in micro_program_interpreter.
 2496/ CA5 :                            ;   Z set (PROG_CTR == $3D): HALT state → skip init, go to multiply.
 2497/ CA5 :                            ;   Z clear (PROG_CTR > $3D): library init → set ACC, reset to $3D.
 2498/ CA5 :                            ; 
 2499/ CA5 :                            ; For normal programs (start_offset=$02): PROG_CTR = $02 + $1D = $1F,
 2500/ CA5 :                            ; below $3D → interpreter fetches opcodes from reg[$1F] normally.
 2501/ CA5 :                            ; 
 2502/ CA5 :                            ; The LFSR noise handler (op_lfsr_noise) at $0C3E jumps directly to
 2503/ CA5 :                            ; finalize_output.multiply, bypassing this path. LFSR voices use real
 2504/ CA5 :                            ; programs (offset $02) with explicit LOAD opcodes to set ACC.
 2505/ CA5 : 6B 25                              JR      Z, finalize_output.multiply
 2506/ CA7 : A6 1B 43                           CP      PROG_CTR, #43h                  ; which library entry? compare PROG_CTR to thresholds
 2507/ CAA : BB 0A                              JR      UGT, .finalize_sub43_check      ; PROG_CTR > $43 → check upper range ($2A/$2E entries)
 2508/ CAC : 6B 04                              JR      Z, .L_0CB2                      ; PROG_CTR == $43: library $26 (ENV=$4000)
 2509/ CAE : 8C 2D                              LD      ACC_HI, #2Dh                    ; PROG_CTR < $43: library $22 (ENV=$2D00 ≈ $2CE4)
 2510/ CB0 : 8B 0B                              JR      .finalize_check
 2511/ CB2 :                            .L_0CB2:                                ; called from: finalize_output($0CAC)
 2512/ CB2 : 8C 40                              LD      ACC_HI, #40h                    ; library $26: ACC = $4000 (quarter range)
 2513/ CB4 : 8B 07                              JR      .finalize_check
 2514/ CB6 :                            .finalize_sub43_check:                                ; 1 refs
 2515/ CB6 : A6 1B 4B                           CP      PROG_CTR, #4Bh                  ; check if PROG_CTR >= $4B (library $2E)
 2516/ CB9 : FB 06                              JR      NC, .finalize_clamp_max         ; PROG_CTR >= $4B → library $2E (ENV=$FFFF)
 2517/ CBB : 8C 80                              LD      ACC_HI, #80h                    ; library $2A: ACC = $8000 (center — standard for noise voices)
 2518/ CBD :                            .finalize_check:                                ; 2 refs
 2519/ CBD : B0 E9                              CLR     ACC_LO                          ; clear low byte (ACC = ACC_HI:$00)
 2520/ CBF : 8B 04                              JR      .finalize_reset_counter
 2521/ CC1 :                            .finalize_clamp_max:                                ; 1 refs
 2522/ CC1 : 8C FF                              LD      ACC_HI, #0FFh                   ; library $2E: ACC = $FFFF (maximum)
 2523/ CC3 : 9C FF                              LD      ACC_LO, #0FFh
 2524/ CC5 :                            .finalize_reset_counter:                                ; 1 refs
 2525/ CC5 : E6 1B 3D                           LD      PROG_CTR, #3Dh                  ; PROG_CTR = $3D → HALT state (library program done, just multiply from now on)
 2526/ CC8 : 8B 02                              JR      finalize_output.multiply
 2527/ CCA :                            finalize_output.entry:                                ; 20 refs
 2528/ CCA : 20 1B                              INC     PROG_CTR
 2529/ CCC :                            finalize_output.multiply:                                ; 12 refs
 2530/ CCC :                            ; 12x12 unsigned fixed-point multiply.
 2531/ CCC :                            ; Formula: R10:R11 = ACC[11:0] * COEFF[11:0] / 2048
 2532/ CCC :                            ; ACC is unsigned 12-bit: {R8[7:0], R9[7:4]} (low nibble of R9 always 0).
 2533/ CCC :                            ; COEFF is 1.11 fixed-point: {PITCH_HI[3:0], PITCH_LO[7:0]}.
 2534/ CCC :                            ;   bit 11 (PITCH_HI bit 3) = integer bit (weight x1.0)
 2535/ CCC :                            ;   bits 10:0 = fractional.  Range: 0.0 to ~2.0. Unity at COEFF=$800.
 2536/ CCC :                            ; PITCH_HI[5:4] = EXSLA staging (not used by multiply).
 2537/ CCC :                            ; PITCH_HI[7:6] = EXSLA bits (used by pitch_apply AFTER multiply).
 2538/ CCC :                            ; 12 unrolled iterations: 8 from PITCH_LO + 4 from PITCH_HI[3:0].
 2539/ CCC :                            ; NOTE: no final RRC after bit 11 iteration -> bit 11 has weight 1.0.
 2540/ CCC :                            ; Carry after bit 11 = genuine overflow (result > 16 bits) -> pitch_overflow.
 2541/ CCC :                            ; With correct ACC base (~$8000), overflow should rarely fire.
 2542/ CCC : C8 12                              LD      R12, PITCH_HI
 2543/ CCE : D8 13                              LD      R13, PITCH_LO                   ; R13=PITCH_LO
 2544/ CD0 : B0 EA                              CLR     R10                             ; clear result accumulator R10:R11
 2545/ CD2 : B0 EB                              CLR     R11
 2546/ CD4 : E0 ED                              RR      R13                             ; coeff bit 0 (PITCH_LO bit 0)
 2547/ CD6 : FB 04                              JR      NC, .mul_bit1
 2548/ CD8 : 02 B9                              ADD     R11, ACC_LO
 2549/ CDA : 12 A8                              ADC     R10, ACC_HI
