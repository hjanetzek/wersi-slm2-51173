 2114/ A7B :                            ; ============================================================
 2115/ A7B :                            ; === STDLINEAR ($A0) — 6-stage linear envelope, 21-byte instruction ($0A7B) ===
 2116/ A7B :                            ; ============================================================
 2117/ A7B :                                    ORG     0A7Bh
 2118/ A7B :                            op_stdlinear:
 2119/ A7B :                            ; STDLINEAR: 6-stage linear envelope with final hold value.
 2120/ A7B :                            ; Opcode $A0, 21 bytes total. Each ECLK tick, adds a step to ACC
 2121/ A7B :                            ; for the current stage's duration, then advances to the next stage.
 2122/ A7B :                            ; 
 2123/ A7B :                            ; Instruction layout (21 bytes, PROG_CTR points to byte[0] = $A0):
 2124/ A7B :                            ;   byte[0]:     $A0 opcode
 2125/ A7B :                            ;   byte[1-3]:   stage 1 {step_hi, step_lo, duration}
 2126/ A7B :                            ;   byte[4-6]:   stage 2 {step_hi, step_lo, duration}
 2127/ A7B :                            ;   byte[7-9]:   stage 3 {step_hi, step_lo, duration}
 2128/ A7B :                            ;   byte[10-12]: stage 4 {step_hi, step_lo, duration}
 2129/ A7B :                            ;   byte[13-15]: stage 5 {step_hi, step_lo, duration}
 2130/ A7B :                            ;   byte[16-18]: stage 6 {step_hi, step_lo, duration}
 2131/ A7B :                            ;   byte[19-20]: final value {acc_hi, acc_lo} (loaded when all stages complete)
 2132/ A7B :                            ; 
 2133/ A7B :                            ; Per-stage execution (each ECLK tick):
 2134/ A7B :                            ;   1. R10 = PROG_CTR + BLOCK_CTR → points to current stage's duration byte
 2135/ A7B :                            ;   2. If LOOP1_CTR > 0: DEC LOOP1_CTR, ACC += step (from bytes before duration)
 2136/ A7B :                            ;   3. If LOOP1_CTR == 0: load duration from @R10, check for stage advance
 2137/ A7B :                            ;   4. If LOOP1_CTR < 0 (bit 7 set = $80): sustain — hold forever at multiply
 2138/ A7B :                            ; 
 2139/ A7B :                            ; Stage advance: BLOCK_CTR += 3, advance to next stage. If BLOCK_CTR > $12 (18)
 2140/ A7B :                            ;   → all 6 stages done: load final ACC from bytes[19:20], clear counters,
 2141/ A7B :                            ;   advance PROG_CTR past 21 bytes, continue to next opcode.
 2142/ A7B :                            ; 
 2143/ A7B :                            ; BLOCK_CTR persists between ECLK ticks (tracks current stage).
 2144/ A7B :                            ; LOOP1_CTR persists (counts down within a stage).
 2145/ A7B :                            ; Both are cleared by update_path on each RAUD — so stages restart from 1.
 2146/ A7B : A8 1B                              LD      R10, PROG_CTR
 2147/ A7D : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; BLOCK_CTR == 0? (first call or after RAUD reset)
 2148/ A80 : EB 03                              JR      NZ, .stage_resume               ; not first → use existing BLOCK_CTR (resume current stage)
 2149/ A82 : E6 1C 03                           LD      BLOCK_CTR, #03h                 ; first call: BLOCK_CTR = 3 (point to stage 1 duration)
 2150/ A85 :                            .stage_resume:                                ; 1 refs
 2151/ A85 : 04 1C EA                           ADD     R10, BLOCK_CTR                  ; R10 = PROG_CTR + BLOCK_CTR → current stage's duration byte
 2152/ A88 : A4 E4 18                           CP      LOOP1_CTR, ZERO                 ; LOOP1_CTR == 0? (need to load new stage?)
 2153/ A8B : EB 08                              JR      NZ, .check_sustain              ; LOOP1_CTR != 0 → check sign and continue current stage
 2154/ A8D :                            .load_duration:                                ; 1 refs
 2155/ A8D : E5 EA 18                           LD      LOOP1_CTR, @R10                 ; load duration: LOOP1_CTR = @R10 (stage's duration byte)
 2156/ A90 : A4 E4 18                           CP      LOOP1_CTR, ZERO
 2157/ A93 : 8B 05                              JR      .check_done                     ; jump to zero-check (skip the MI/DEC path)
 2158/ A95 :                            .check_sustain:                                ; 1 refs
 2159/ A95 : 5D 0C CC                           JP      MI, finalize_output.multiply    ; LOOP1_CTR < 0 (bit 7 set) → sustain: hold at multiply forever
 2160/ A98 : 00 18                              DEC     LOOP1_CTR                       ; DEC LOOP1_CTR (count down one ECLK tick)
 2161/ A9A :                            .check_done:                                ; 1 refs
 2162/ A9A : 6B 0B                              JR      Z, .advance_stage               ; LOOP1_CTR == 0 after DEC or load? → advance to next stage
 2163/ A9C : 00 EA                              DEC     R10                             ; DEC R10 → points to step_lo
 2164/ A9E : 03 9A                              ADD     ACC_LO, @R10                    ; ACC_LO += step_lo
 2165/ AA0 : 00 EA                              DEC     R10                             ; DEC R10 → points to step_hi
 2166/ AA2 : 13 8A                              ADC     ACC_HI, @R10                    ; ACC_HI += step_hi (with carry from step_lo add)
 2167/ AA4 : 8D 0C CC                           JP      finalize_output.multiply        ; → multiply with updated ACC
 2168/ AA7 :                            .advance_stage:                                ; 1 refs
 2169/ AA7 : 06 1C 03                           ADD     BLOCK_CTR, #03h                 ; advance to next stage: BLOCK_CTR += 3, R10 += 3
 2170/ AAA : 06 EA 03                           ADD     R10, #03h
 2171/ AAD : A6 1C 12                           CP      BLOCK_CTR, #12h                 ; BLOCK_CTR <= $12 (18)? → more stages remain, loop back
 2172/ AB0 : 3B DB                              JR      ULE, .load_duration
 2173/ AB2 :                            .all_stages_done:
 2174/ AB2 : A9 1B                              LD      PROG_CTR, R10                   ; all 6 stages done: PROG_CTR = R10 (advance past 21-byte instruction)
 2175/ AB4 : 00 EA                              DEC     R10                             ; load final ACC value from bytes[19:20]
 2176/ AB6 : E3 9A                              LD      ACC_LO, @R10
 2177/ AB8 : 00 EA                              DEC     R10
 2178/ ABA : E3 8A                              LD      ACC_HI, @R10
 2179/ ABC : B0 1C                              CLR     BLOCK_CTR                       ; clear BLOCK_CTR and LOOP1_CTR (envelope complete)
 2180/ ABE : B0 18                              CLR     LOOP1_CTR
 2181/ AC0 : 8D 0C CC                           JP      finalize_output.multiply        ; → multiply with final ACC value
 2182/ AC3 :                            
 2183/ AC3 :                            ; ============================================================
 2184/ AC3 :                            ; === VIBRATO1 ($80) — alternating coefficient multiply, 4-byte ($0AC3) ===
 2185/ AC3 :                            ; ============================================================
 2186/ AC3 :                                    ORG     0AC3h
 2187/ AC3 :                            op_vibrato1:
 2188/ AC3 :                            ; Vibrato 1: alternating coefficient multiply. Opcode $80, 4-byte.
 2189/ AC3 :                            ; Layout: {opcode, coeff1, coeff2, loop_count}
 2190/ AC3 :                            ; Uses BLOCK_CTR (reg[$1C]) as toggle between two coefficients.
 2191/ AC3 :                            ;   $1C==0: reload loop counter from FREQ[3], toggle $1C
 2192/ AC3 :                            ;   $1C!=0: DEC counter, multiply by coeff1 or coeff2 based on toggle
 2193/ AC3 :                            ; Alternates R8:R9 *= coeff1 and R8:R9 += coeff2 × R8:R9.
 2194/ AC3 :                            ; Creates vibrato by periodically scaling ACC between two rates.
 2195/ AC3 : 66 10 40                           TCM     MODE, #40h
 2196/ AC6 : 6D 0C CC                           JP      Z, finalize_output.multiply     ; MODE bit 6 clear → skip vibrato, go to finalize_output.multiply
 2197/ AC9 : A8 1B                              LD      R10, PROG_CTR
 2198/ ACB : A4 E4 18                           CP      LOOP1_CTR, ZERO                 ; LOOP1_CTR (reg[$18]) == 0?
 2199/ ACE : EB 0C                              JR      NZ, .L_0ADC                     ; non-zero → already running, go to coeff_step
 2200/ AD0 : 60 1C                              COM     BLOCK_CTR                       ; toggle BLOCK_CTR (alternate coefficient selection)
 2201/ AD2 : C7 BA 03                           LD      R11, 03h(R10)                   ; reload loop counter from FREQ[3]
 2202/ AD5 : B9 18                              LD      LOOP1_CTR, R11
 2203/ AD7 : A2 B4                              CP      R11, ZERO                       ; counter == 0 → no iterations, skip to finalize
 2204/ AD9 : 6D 0C CC                           JP      Z, finalize_output.multiply
 2205/ ADC :                            .L_0ADC:                                ; called from: op_vibrato1($0ACE)
 2206/ ADC : 00 1B                              DEC     PROG_CTR                        ; DEC PROG_CTR (back up to re-read opcode on next pass)
 2207/ ADE : 00 18                              DEC     LOOP1_CTR                       ; DEC LOOP1_CTR
 2208/ AE0 : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; BLOCK_CTR toggle state? 0 = use coeff2, else = use coeff1
 2209/ AE3 : 6B 06                              JR      Z, .vib1_use_coeff2
 2210/ AE5 : C7 CA 01                           LD      R12, 01h(R10)                   ; R12 = FREQ[1] (coefficient 1)
 2211/ AE8 : 8D 07 4D                           JP      multiply_8x16_r8r9              ; → multiply_8x16_r8r9 (R8:R9 *= R12)
 2212/ AEB :                            .vib1_use_coeff2:                                ; 1 refs
 2213/ AEB : C7 CA 02                           LD      R12, 02h(R10)                   ; R12 = FREQ[2] (coefficient 2)
 2214/ AEE : 8D 07 E9                           JP      multiply_acc_r8r9               ; → multiply_acc_r8r9 (R8:R9 += R12 × R8:R9)
 2215/ AF1 :                            
 2216/ AF1 :                            ; ============================================================
 2217/ AF1 :                            ; === VIBRATO2 ($90) — sine phase modulation, 4-byte ($0AF1) ===
 2218/ AF1 :                            ; ============================================================
 2219/ AF1 :                                    ORG     0AF1h
 2220/ AF1 :                            op_vibrato2:
 2221/ AF1 :                            ; Vibrato 2: sine-wave phase modulation. Opcode $90, 4-byte.
 2222/ AF1 :                            ; Layout: {opcode, saved_R9, phase_increment, freq_param}
 2223/ AF1 :                            ; Phase accumulator in reg[$14:$15], starts at $4000 (quarter-wave).
 2224/ AF1 :                            ; Each iteration: phase += increment, sine ROM lookup at $0FC0-$0FFF,
 2225/ AF1 :                            ; multiply sine × freq_param, sign-correct by quadrant, add to R8:R9.
 2226/ AF1 :                            ; Uses reg[$16:$17] as frequency, reg[$18:$19] as phase step.
 2227/ AF1 :                            ; Creates periodic pitch modulation (vibrato/tremolo).
 2228/ AF1 : 66 10 40                           TCM     MODE, #40h
 2229/ AF4 : 6D 0C CC                           JP      Z, finalize_output.multiply     ; MODE bit 6 clear → skip vibrato
 2230/ AF7 : A8 1B                              LD      R10, PROG_CTR
 2231/ AF9 : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; BLOCK_CTR == 0? (first call)
 2232/ AFC : EB 22                              JR      NZ, .vib2_iteration             ; non-zero → already initialized, go to iteration
 2233/ AFE : AE                                 INC     R10                             ; first call: load loop count from FREQ[1]
 2234/ AFF : E5 EA 1C                           LD      BLOCK_CTR, @R10
 2235/ B02 : A4 E4 1C                           CP      BLOCK_CTR, ZERO
 2236/ B05 : 6D 0C CC                           JP      Z, finalize_output.multiply     ; loop count == 0 → skip
 2237/ B08 :                            .vib2_save_r9:
 2238/ B08 : F3 A9                              LD      @R10, ACC_LO                    ; save R9 to FREQ[1] (overwrite loop count with ACC_LO)
 2239/ B0A : 89 11                              LD      LFSR_VIB_STATE, ACC_HI          ; save R8 to LFSR_VIB_STATE (reg[$11])
 2240/ B0C : AE                                 INC     R10
 2241/ B0D : E5 EA 19                           LD      LOOP2_CTR, @R10                 ; reg[$19] = FREQ[2] (phase increment)
 2242/ B10 : B0 18                              CLR     LOOP1_CTR
 2243/ B12 : AE                                 INC     R10                             ; reg[$17] = FREQ[3] (frequency param)
 2244/ B13 : E5 EA 17                           LD      ACC3_LO, @R10
 2245/ B16 : B0 16                              CLR     ACC3_HI                         ; phase accumulator = $4000 (quarter-wave start)
 2246/ B18 : E6 15 00                           LD      ACC2_LO, #00h
 2247/ B1B : E6 14 40                           LD      ACC2_HI, #40h
 2248/ B1E : 8B 1D                              JR      .vib2_sine_lookup
 2249/ B20 :                            .vib2_iteration:                                ; 1 refs
 2250/ B20 : A6 1C 01                           CP      BLOCK_CTR, #01h                 ; DEC loop counter
 2251/ B23 : 6B 12                              JR      Z, .vib2_last_iter
 2252/ B25 : 00 1C                              DEC     BLOCK_CTR
 2253/ B27 : 06 EA 02                           ADD     R10, #02h                       ; phase += increment
 2254/ B2A : 05 EA 19                           ADD     LOOP2_CTR, @R10
 2255/ B2D : 14 E4 18                           ADC     LOOP1_CTR, ZERO
 2256/ B30 : AE                                 INC     R10
 2257/ B31 : 05 EA 17                           ADD     ACC3_LO, @R10                   ; freq += param
 2258/ B34 : 14 E4 16                           ADC     ACC3_HI, ZERO
 2259/ B37 :                            .vib2_last_iter:                                ; 1 refs
 2260/ B37 : 04 19 15                           ADD     ACC2_LO, LOOP2_CTR              ; phase_acc += phase_step
 2261/ B3A : 14 18 14                           ADC     ACC2_HI, LOOP1_CTR
 2262/ B3D :                            .vib2_sine_lookup:                                ; 1 refs
 2263/ B3D : D8 14                              LD      R13, ACC2_HI                    ; R13 = phase high byte (quadrant selector)
 2264/ B3F : 66 14 40                           TCM     ACC2_HI, #40h                   ; test quadrant bit 6
 2265/ B42 : EB 03                              JR      NZ, .vib2_no_negate             ; quadrant 2 or 4: negate R13 (COM+INC)
 2266/ B44 : 60 ED                              COM     R13
 2267/ B46 : DE                                 INC     R13
 2268/ B47 :                            .vib2_no_negate:                                ; 1 refs
 2269/ B47 : 56 ED 7F                           AND     R13, #7Fh                       ; mask to 0-127 (half-wave index)
 2270/ B4A : 6B 42                              JR      Z, .vib2_clr_r8                 ; zero sine → skip multiply
 2271/ B4C : 06 ED BF                           ADD     R13, #0BFh                      ; index into sine ROM table at $0FC0-$0FFF
 2272/ B4F : CC 0F                              LD      R12, #0Fh                       ; R12:R13 = $0F:index → ROM lookup
 2273/ B51 : C2 DC                              LDC     R13, @RR12                      ; R13 = sine table value
 2274/ B53 : CC 08                              LD      R12, #08h                       ; 8x8 multiply: sine × reg[$16:$17]
 2275/ B55 : B0 E8                              CLR     ACC_HI
 2276/ B57 : B0 E9                              CLR     ACC_LO
 2277/ B59 :                            .L_0B59:                                ; called from: .L_0B63($0B67)
 2278/ B59 : E0 ED                              RR      R13
 2279/ B5B : FB 06                              JR      NC, .L_0B63
 2280/ B5D : 04 17 E9                           ADD     ACC_LO, ACC3_LO
 2281/ B60 : 14 16 E8                           ADC     ACC_HI, ACC3_HI
 2282/ B63 :                            .L_0B63:                                ; called from: .L_0B59($0B5B)
 2283/ B63 : C0 E8                              RRC     ACC_HI
 2284/ B65 : C0 E9                              RRC     ACC_LO
 2285/ B67 : CA F0                              DJNZ    R12, .L_0B59
 2286/ B69 : CF                                 RCF
 2287/ B6A : C0 E8                              RRC     ACC_HI
 2288/ B6C : C0 E9                              RRC     ACC_LO
 2289/ B6E : D0 E8                              SRA     ACC_HI
 2290/ B70 : C0 E9                              RRC     ACC_LO
 2291/ B72 : D0 E8                              SRA     ACC_HI
 2292/ B74 : C0 E9                              RRC     ACC_LO
 2293/ B76 : 66 14 80                           TCM     ACC2_HI, #80h                   ; quadrant 3 or 4: negate result (COM+INCW)
 2294/ B79 : EB 06                              JR      NZ, .vib2_exit
 2295/ B7B : 60 E8                              COM     ACC_HI
 2296/ B7D : 60 E9                              COM     ACC_LO
 2297/ B7F : A0 E8                              INCW    RR8
 2298/ B81 :                            .vib2_exit:                                ; 2 refs
 2299/ B81 : 20 1B                              INC     PROG_CTR                        ; add saved ACC offset: R8:R9 += saved values
 2300/ B83 : 05 1B E9                           ADD     ACC_LO, @PROG_CTR
 2301/ B86 : 14 11 E8                           ADC     ACC_HI, LFSR_VIB_STATE
 2302/ B89 : 00 1B                              DEC     PROG_CTR
 2303/ B8B : 8D 0C CC                           JP      finalize_output.multiply        ; → finalize_output.multiply
 2304/ B8E :                            .vib2_clr_r8:                                ; 1 refs
 2305/ B8E : B0 E8                              CLR     ACC_HI                          ; zero sine: CLR R8:R9, then add saved offset
 2306/ B90 : B0 E9                              CLR     ACC_LO
 2307/ B92 : 8B ED                              JR      .vib2_exit
 2308/ B94 :                            
 2309/ B94 :                            ; ============================================================
 2310/ B94 :                            ; === NOISE ($10) — 16-bit Galois LFSR pitch modulation, 4-byte ($0B94) ===
 2311/ B94 :                            ; ============================================================
 2312/ B94 :                                    ORG     0B94h
 2313/ B94 :                            op_lfsr_noise:
 2314/ B94 :                            ; op_lfsr_noise: 16-bit Galois LFSR pitch modulation
 2315/ B94 :                            ; Micro-program opcode $10, 4-byte instruction: {opcode, running_state, coefficient, counter/lfsr_low}
 2316/ B94 :                            ; Three paths based on BLOCK_CTR (reg[$1C]):
 2317/ B94 :                            ;   counter==0: reload from FREQ[3], do short LFSR, advance if zero
 2318/ B94 :                            ;   counter>0:  decrement, 8-bit LFSR step (high byte only, XOR $1D)
 2319/ B94 :                            ;   counter<0:  full 16-bit LFSR step + pitch envelope S&H from COP
 2320/ B94 :                            ; Exit: differenced noise x coefficient -> R8:R9 -> finalize_output.multiply
 2321/ B94 : A8 1B                              LD      R10, PROG_CTR
 2322/ B96 : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; block counter == 0?
 2323/ B99 : EB 0A                              JR      NZ, .counter_nonzero            ; non-zero → check sign
