  764/ 3A5 :                            ; ============================================================
  765/ 3A5 :                            ; === FULL VOICE SETUP ($03A5) ===
  766/ 3A5 :                            ; ============================================================
  767/ 3A5 :                                    ORG     03A5h
  768/ 3A5 :                            .cmd_full_setup:                                ; 1 refs
  769/ 3A5 :                            ; Full voice setup. Bulk-loads slave RAM parameters into registers,
  770/ 3A5 :                            ; then sets up LFSR state, pitch envelope, EXSLA, and micro-program.
  771/ 3A5 :                            ; 
  772/ 3A5 :                            ; LDEI chain: R11=$F9 (source), R12=$0F (dest). 7 iterations:
  773/ 3A5 :                            ;   sram[$F9] → reg[$0F] = R15 (WAVE_R15)  wrap point / sample count
  774/ 3A5 :                            ;   sram[$FA] → reg[$10] = MODE             synthesis mode + sub-mode
  775/ 3A5 :                            ;   sram[$FB] → reg[$11] = LFSR_VIB_STATE  → ACC3_HI (saved, then $DB overwrites)
  776/ 3A5 :                            ;   sram[$FC] → reg[$12] = PITCH_HI         frequency coefficient high
  777/ 3A5 :                            ;   sram[$FD] → reg[$13] = PITCH_LO         frequency coefficient low
  778/ 3A5 :                            ;   sram[$FE] → reg[$14] = ACC2_HI          pitch envelope param (NOT R14!)
  779/ 3A5 :                            ;   sram[$FF] → reg[$15] = ACC2_LO          pitch fine value (NOT R15!)
  780/ 3A5 :                            ; 
  781/ 3A5 :                            ; Note: ACC2_HI/LO are reg[$14/$15], NOT the same as R14/R15 (reg[$0E/$0F]).
  782/ 3A5 :                            ; After LDEI: R11=$00 (wrapped), R12=$16.
  783/ 3A5 : 8F                                 DI
  784/ 3A6 : E6 FB 08                           LD      0FBh, #08h                      ; 0FB=IMR (interrupt mask)
  785/ 3A9 : D9 FC                              LD      0FCh, R13                       ; 0FC=FLAGS (flags register)  ; FLAGS = R13 (save command byte for irq3_first_time check)
  786/ 3AB : 56 ED F8                           AND     R13, #0F8h                      ; R13 = (R13 & $F8) + $02 → slave address for bus handshake
  787/ 3AE : 06 ED 02                           ADD     R13, #02h
  788/ 3B1 : 28 ED                              LD      PORT2, R13                      ; PORT2 = R13 (assert slave select on bus)
  789/ 3B3 : BC F9                              LD      R11, #0F9h                      ; R11 = $F9 (LDEI source start: sram[$F9])
  790/ 3B5 : CC 0F                              LD      R12, #0Fh                       ; R12 = $0F (LDEI dest start: reg[$0F] = R15)
  791/ 3B7 : 83 CA                              LDEI    @R12, @RR10                     ; sram[$F9] → reg[$0F] = R15: wrap point (Mode C) / sample count (Mode B)
  792/ 3B9 : 83 CA                              LDEI    @R12, @RR10                     ; sram[$FA] → reg[$10] = MODE: mode bits 5:4 + sub bits 3:0
  793/ 3BB : 83 CA                              LDEI    @R12, @RR10                     ; sram[$FB] → reg[$11] = LFSR_VIB_STATE: used for ACC3_HI init, then overwritten to $DB
  794/ 3BD : 83 CA                              LDEI    @R12, @RR10                     ; sram[$FC] → reg[$12] = PITCH_HI: coeff high (bits 3:0 = multiply, 7:6 = EXSLA)
  795/ 3BF : 83 CA                              LDEI    @R12, @RR10                     ; sram[$FD] → reg[$13] = PITCH_LO: coeff low
  796/ 3C1 : 83 CA                              LDEI    @R12, @RR10                     ; sram[$FE] → reg[$14] = ACC2_HI: pitch envelope param
  797/ 3C3 : 83 CA                              LDEI    @R12, @RR10                     ; sram[$FF] → reg[$15] = ACC2_LO: pitch fine value (from voice_write_pitch)
  798/ 3C5 : E4 11 16                           LD      ACC3_HI, LFSR_VIB_STATE         ; ACC3_HI = sram[$FB] (move to reg[$16] — this is the actual use of sram[$FB])
  799/ 3C8 : B0 17                              CLR     ACC3_LO                         ; ACC3_LO = 0
  800/ 3CA : E6 11 DB                           LD      LFSR_VIB_STATE, #0DBh           ; LFSR_VIB_STATE = $DB (fixed init seed for LFSR/vibrato)
  801/ 3CD : 66 10 80                           TCM     MODE, #80h                      ; MODE bit 7: pitch envelope enable?
  802/ 3D0 : 6B 05                              JR      Z, .pitch_env_from_acc2         ; bit 7 SET (Z) → pitch tracking active: load PITCH_ENV + EXSLA
  803/ 3D2 : E6 1A 00                           LD      PITCH_ENV, #00h                 ; bit 7 CLEAR: fixed formant, no pitch modulation
  804/ 3D5 : 8B 12                              JR      .load_micro_program             ; skip EXSLA setup
  805/ 3D7 :                            .pitch_env_from_acc2:                                ; 1 refs
  806/ 3D7 : E4 15 1A                           LD      PITCH_ENV, ACC2_LO              ; initial pitch envelope = ACC2_LO (reg[$15])
  807/ 3DA : C8 E3                              LD      R12, PORT3                      ; read EXSLA routing from Port 3
  808/ 3DC : F0 EC                              SWAP    R12
  809/ 3DE : 90 EC                              RL      R12
  810/ 3E0 : 56 EC C0                           AND     R12, #0C0h
  811/ 3E3 : 56 12 3F                           AND     PITCH_HI, #3Fh                  ; merge EXSLA bits [7:6] into PITCH_HI (reg[$12])
  812/ 3E6 : 44 EC 12                           OR      PITCH_HI, R12
  813/ 3E9 :                            .load_micro_program:                                ; 1 refs
  814/ 3E9 : 4C 02                              LD      ZERO, #02h                      ; R4:R5 = call address for LDEI sled ($02:computed)
  815/ 3EB : 5C DD                              LD      MICRO_OP, #0DDh                 ; R5 = $DD (end of LDEI sled)
  816/ 3ED : BC F4                              LD      R11, #0F4h                      ; R11 = slave_ram[$F4] (harmonic byte → sled offset)
  817/ 3EF : 82 CA                              LDE     R12, @RR10                      ; R12 = harmonic count from slave RAM
  818/ 3F1 : 22 5C                              SUB     MICRO_OP, R12                   ; R5 -= 2*harmonics (each LDEI is 2 bytes)
  819/ 3F3 : 22 5C                              SUB     MICRO_OP, R12
  820/ 3F5 : BC F5                              LD      R11, #0F5h                      ; R11 = slave_ram[$F5]
  821/ 3F7 : 82 BA                              LDE     R11, @RR10                      ; R11 = slave_ram[$F5] (micro-program data source pointer)
  822/ 3F9 : CC 1D                              LD      R12, #1Dh                       ; R12 = $1D (LDEI destination: reg[$1D] onward = micro-program storage)
  823/ 3FB : D4 E4                              CALL    @RR4                            ; CALL @RR4 → computed jump into LDEI sled at $02xx, loads N bytes from slave RAM
  824/ 3FD : E4 1D 1B                           LD      PROG_CTR, TIMER_VAL             ; PROG_CTR = reg[$1D] (first micro-program byte = start_offset / library address)
  825/ 400 : 0C 80                              LD      PORT0_DAC, #80h
  826/ 402 : B0 E7                              CLR     PHASE
  827/ 404 : 66 10 20                           TCM     MODE, #20h
  828/ 407 : 6D 05 0E                           JP      Z, synthesis_mode_a
  829/ 40A : 66 10 10                           TCM     MODE, #10h
  830/ 40D : ED 04 DD                           JP      NZ, synthesis_mode_b
  831/ 410 : 7C 40                              LD      PHASE, #40h
  832/ 412 :                            
  833/ 412 :                            ; ============================================================
  834/ 412 :                            ; === Mode C setup — wrap-point division + wavetable fill ($F2). MODE bits 5:4 = $10 ($0412) ===
  835/ 412 :                            ; ============================================================
  836/ 412 :                                    ORG     0412h
  837/ 412 :                            synthesis_mode_c:
  838/ 412 :                            ; Mode C setup: 8-bit restoring division + wavetable fill.
  839/ 412 :                            ; Computes a wrap offset via division, stores it at reg[$7F], then fills
  840/ 412 :                            ; reg[$40-$7E] with delta-adjusted waveform samples from slave RAM.
  841/ 412 :                            ; 
  842/ 412 :                            ; Runtime ($F2 micro-op): DAC = reg[$40+PHASE]; if PHASE >= R15: wrap to 0,
  843/ 412 :                            ;   else PHASE += R14. So R14=freq step, R15=wrap point (wavetable length).
  844/ 412 :                            ; 
  845/ 412 :                            ; Setup inputs (R14/R15 used as temps during setup, NOT runtime values):
  846/ 412 :                            ;   sram[$F7] → R14 (temp): freq step (also used by $F2 at runtime)
  847/ 412 :                            ;   sram[$F6] → R5 (MICRO_OP, temp): waveform source offset in slave RAM
  848/ 412 :                            ;   R15 (= reg[$0F], from sram[$F9] via full_setup LDEI): wrap point / wavetable length
  849/ 412 :                            ; 
  850/ 412 :                            ; Algorithm:
  851/ 412 :                            ;   1. Read last waveform sample from sram[sram[$F6] + $3F]
  852/ 412 :                            ;   2. Compute dividend = ((last_sample - freq_step)/2 + R15 + 1) / 2
  853/ 412 :                            ;   3. Compute divisor = ($41 + R15) / 2
  854/ 412 :                            ;   4. 8-bit restoring division: quotient → R14 (temp)
  855/ 412 :                            ;   5. Complement quotient, store at reg[$7F] (wrap-boundary value)
  856/ 412 :                            ;   6. Compute delta = complemented_quotient - next_sample
  857/ 412 :                            ;   7. Fill reg[$40-$7E] with (sample + delta) from slave RAM backward
  858/ 412 :                            ;   8. Restore R10=$10 (slave RAM bank), JP synthesis_loop_entry
  859/ 412 : BC F7                              LD      R11, #0F7h
  860/ 414 : 82 EA                              LDE     WAVE_R14, @RR10                 ; R14 = sram[$F7] = freq step (temp: used in division)
  861/ 416 : BC F6                              LD      R11, #0F6h
  862/ 418 : 82 5A                              LDE     MICRO_OP, @RR10                 ; R5 = sram[$F6] = waveform source offset
  863/ 41A : 06 E5 3F                           ADD     MICRO_OP, #3Fh                  ; R5 += $3F → point to last sample in waveform area
  864/ 41D : 4C 10                              LD      ZERO, #10h                      ; R4 = $10 (set up RR4 = $10:R5 for slave RAM reads)
  865/ 41F : 82 A4                              LDE     R10, @RR4                       ; R10 = sram[R4:R5] = last waveform sample
  866/ 421 : B0 EB                              CLR     R11                             ; R11 = 0 (extend to 16-bit for division)
  867/ 423 : 22 AE                              SUB     R10, WAVE_R14                   ; R10 -= R14 (last_sample - freq_step)
  868/ 425 : CF                                 RCF
  869/ 426 : C0 EA                              RRC     R10
  870/ 428 : C0 EB                              RRC     R11
  871/ 42A : AE                                 INC     R10                             ; R10 += 1
  872/ 42B : 02 AF                              ADD     R10, WAVE_R15                   ; R10 += R15 (add wrap point)
  873/ 42D : C0 EA                              RRC     R10                             ; RRC R10:R11 → divide by 2 again (dividend ready)
  874/ 42F : C0 EB                              RRC     R11
  875/ 431 : B0 ED                              CLR     R13                             ; R13 = 0 (divisor low byte)
  876/ 433 : CC 41                              LD      R12, #41h                       ; R12 = $41 + R15 (divisor base)
  877/ 435 : 02 CF                              ADD     R12, WAVE_R15
  878/ 437 : B0 EE                              CLR     WAVE_R14                        ; R14 = 0 (quotient accumulator)
  879/ 439 : C0 EC                              RRC     R12                             ; RRC R12:R13 → divisor / 2 (first bit position)
  880/ 43B : C0 ED                              RRC     R13
  881/ 43D : 22 BD                              SUB     R11, R13                        ; --- 8-bit restoring division: 8 unrolled iterations ---
  882/ 43F : 32 AC                              SBC     R10, R12
  883/ 441 : FB 04                              JR      NC, .div_bit1
  884/ 443 : 02 BD                              ADD     R11, R13
  885/ 445 : 12 AC                              ADC     R10, R12
  886/ 447 :                            .div_bit1:                                ; 1 refs
  887/ 447 : 10 EE                              RLC     WAVE_R14
  888/ 449 : C0 EC                              RRC     R12
  889/ 44B : C0 ED                              RRC     R13
  890/ 44D : 22 BD                              SUB     R11, R13
  891/ 44F : 32 AC                              SBC     R10, R12
  892/ 451 : FB 04                              JR      NC, .div_bit2
  893/ 453 : 02 BD                              ADD     R11, R13
  894/ 455 : 12 AC                              ADC     R10, R12
