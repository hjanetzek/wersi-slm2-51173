 2405/ EAA : E6 F8 0C                           LD      0F8h, #0Ch                      ; 0F8=P01M (port 0/1 mode)  ; set P01M to output mode (Port 0 = DAC data, Port 1 = bus)
 2406/ EAD : B6 E2 07                           XOR     PORT2, #07h                     ; toggle Port 2 bus control bits (release slave RAM bus)
