  969/ 4DD :                            ; ============================================================
  970/ 4DD :                            ; === Mode B setup — waveform load + variable-duty DDS ($CF). MODE bits 5:4 = $00 ($04DD) ===
  971/ 4DD :                            ; ============================================================
  972/ 4DD :                                    ORG     04DDh
  973/ 4DD :                            synthesis_mode_b:                                ; 1 refs
  974/ 4DD :                            ; Mode B waveform loading. Copies samples from slave RAM into reg[$40+].
  975/ 4DD :                            ; Two paths based on sram[$F7] (R14, here used as temp = sample delta):
  976/ 4DD :                            ; 
  977/ 4DD :                            ;   R14 != 0 (delta mode): manual loop copies R15 samples from sram[R11],
  978/ 4DD :                            ;     subtracting R14 from each sample. Stores at reg[$40+R15] downward.
  979/ 4DD :                            ;     This creates a DC-offset-removed waveform (R14 = DC bias to remove).
  980/ 4DD :                            ; 
  981/ 4DD :                            ;   R14 == 0 (direct mode): uses LDEI sled to bulk-copy R15 samples from
  982/ 4DD :                            ;     sram[R11] into reg[$40] onward. No per-sample processing.
  983/ 4DD :                            ; 
  984/ 4DD :                            ;   sram[$F7]: sample delta / DC offset to subtract (0 = no subtraction)
  985/ 4DD :                            ;   sram[$F6]: waveform source address in slave RAM
  986/ 4DD :                            ;   R15 (= reg[$0F], from sram[$F9] via full_setup LDEI): sample count - 1
  987/ 4DD :                            ; 
  988/ 4DD :                            ; After loading: falls through to synthesis_loop_entry.
  989/ 4DD : BC F7                              LD      R11, #0F7h
  990/ 4DF : 82 EA                              LDE     WAVE_R14, @RR10
  991/ 4E1 : BC F6                              LD      R11, #0F6h                      ; R11 = sram[$F6] = waveform source address in slave RAM
  992/ 4E3 : 82 BA                              LDE     R11, @RR10
  993/ 4E5 : A6 EE 00                           CP      WAVE_R14, #00h                  ; R14 == 0? (no delta subtraction needed?)
  994/ 4E8 : 6B 18                              JR      Z, .wave_ldei_path              ; R14 == 0 → direct LDEI copy path
  995/ 4EA : 02 BF                              ADD     R11, WAVE_R15                   ; R11 += R15 → point to end of source (loop copies backward)
  996/ 4EC : D8 EF                              LD      R13, WAVE_R15                   ; R13 = R15 (loop counter = sample count)
  997/ 4EE :                            .wave_copy_loop:                                ; 1 refs
  998/ 4EE : 82 CA                              LDE     R12, @RR10                      ; R12 = sram[R11] (read one sample from slave RAM)
  999/ 4F0 : 22 CE                              SUB     R12, WAVE_R14                   ; R12 -= R14 (subtract DC offset / delta)
 1000/ 4F2 : D7 CD 40                           LD      40h(R13), R12                   ; reg[$40+R13] = R12 (store processed sample in wavetable area)
 1001/ 4F5 : 00 EB                              DEC     R11                             ; DEC R11 (move to previous source byte)
 1002/ 4F7 : DA F5                              DJNZ    R13, .wave_copy_loop            ; DJNZ R13 → loop (R13 counts down, stores at $40+R13...$40+1)
 1003/ 4F9 : 82 CA                              LDE     R12, @RR10                      ; last sample: R12 = sram[R11]
 1004/ 4FB : 22 CE                              SUB     R12, WAVE_R14                   ; R12 -= R14
 1005/ 4FD : D7 CD 40                           LD      40h(R13), R12                   ; reg[$40+0] = R12 (store at reg[$40], completing the table)
 1006/ 500 : 8B 79                              JR      synthesis_loop_entry            ; → synthesis_loop_entry
 1007/ 502 :                            .wave_ldei_path:                                ; 1 refs
 1008/ 502 : CC 40                              LD      R12, #40h                       ; direct copy path (R14 == 0): use LDEI sled
 1009/ 504 : 5C DD                              LD      MICRO_OP, #0DDh                 ; R5 = $DD (end of LDEI sled)
 1010/ 506 : 22 5F                              SUB     MICRO_OP, WAVE_R15              ; R5 -= R15 * 2 (compute sled entry for R15 bytes)
