 3014/ F92 :                            ; ============================================================
 3015/ F92 :                            ; === Normalize underflow: shift R12:R11 left until R12 >= $1E ($0F92) ===
 3016/ F92 :                            ; ============================================================
 3017/ F92 :                                    ORG     0F92h
 3018/ F92 :                            finalize_output.underflow_shift:                                ; 2 refs
 3019/ F92 :                            ; normalize: floating-point normalization of multiply result.
 3020/ F92 :                            ; R12:R11 = mantissa (multiply result), R13 = exponent (sub mode).
 3021/ F92 :                            ; Shifts mantissa left (x2) and INC exponent until R12 >= $1E.
 3022/ F92 :                            ; Each sub INCrement selects a faster timer / simpler micro-op chain.
 3023/ F92 :                            ; R11 bits 7:5 become the fractional dither index at pitch_output
 3024/ F92 :                            ; (3 bits of sub-sample pitch precision from the normalize remainder).
 3025/ F92 :                            ; Sub caps at $0F (15). If still < $1E at cap: force R12=$1E, R11=0
 3026/ F92 :                            ; (no dither = exact pitch, enters underflow_shift_entry skipping dither lookup).
 3027/ F92 : A6 ED 0F                           CP      R13, #0Fh
 3028/ F95 : FB 0E                              JR      NC, .L_0FA5                     ; sub < 15 → keep normalizing
 3029/ F97 : DE                                 INC     R13                             ; INC sub (exponent++)
 3030/ F98 : CF                                 RCF
 3031/ F99 : 10 EB                              RLC     R11                             ; RLC R11:R12 = mantissa x2 (shift bits up, dither bits accumulate in R11)
 3032/ F9B : 10 EC                              RLC     R12
 3033/ F9D : A6 EC 1E                           CP      R12, #1Eh                       ; R12 >= $1E? mantissa normalized → pitch_output (R11 has dither in bits 7:5)
 3034/ FA0 : FD 0D F8                           JP      NC, finalize_output.pitch_output
 3035/ FA3 : 8B ED                              JR      finalize_output.underflow_shift ; loop: keep shifting until normalized or capped
 3036/ FA5 :                            .L_0FA5:                                ; called from: finalize_output.underflow_shift($0F95)
 3037/ FA5 : CC 1E                              LD      R12, #1Eh                       ; cap: force R12=$1E (minimum normalized magnitude)
 3038/ FA7 : B0 EB                              CLR     R11                             ; R11=0 → SPH=$00 at synthesis_output → no timer dither (exact integer pitch)
 3039/ FA9 : 8D 0E 06                           JP      finalize_output.pitch_output.underflow_shift_entry; → underflow_shift_entry: skip dither table lookup, R11=0 passes through to SPH
