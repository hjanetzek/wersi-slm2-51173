 1750/ AC3 :                            ; ============================================================
 1751/ AC3 :                            ; === Vibrato 1 — alternating coefficient multiply ($80 opcode, 4-byte) ($0AC3) ===
 1752/ AC3 :                            ; ============================================================
 1753/ AC3 :                                    ORG     0AC3h
 1754/ AC3 :                            op_vibrato1:
 1755/ AC3 :                            ; Vibrato 1: alternating coefficient multiply. Opcode $80, 4-byte.
 1756/ AC3 :                            ; Layout: {opcode, coeff1, coeff2, loop_count}
 1757/ AC3 :                            ; Uses BLOCK_CTR (reg[$1C]) as toggle between two coefficients.
 1758/ AC3 :                            ;   $1C==0: reload loop counter from FREQ[3], toggle $1C
 1759/ AC3 :                            ;   $1C!=0: DEC counter, multiply by coeff1 or coeff2 based on toggle
 1760/ AC3 :                            ; Alternates R8:R9 *= coeff1 and R8:R9 += coeff2 × R8:R9.
 1761/ AC3 :                            ; Creates vibrato by periodically scaling ACC between two rates.
 1762/ AC3 : 66 10 40                           TCM     MODE, #40h
 1763/ AC6 : 6D 0C CC                           JP      Z, finalize_output.multiply     ; MODE bit 6 clear → skip vibrato, go to finalize_output.multiply
 1764/ AC9 : A8 1B                              LD      R10, PROG_CTR
 1765/ ACB : A4 E4 18                           CP      LOOP1_CTR, ZERO                 ; LOOP1_CTR (reg[$18]) == 0?
 1766/ ACE : EB 0C                              JR      NZ, .L_0ADC                     ; non-zero → already running, go to coeff_step
 1767/ AD0 : 60 1C                              COM     BLOCK_CTR                       ; toggle BLOCK_CTR (alternate coefficient selection)
 1768/ AD2 : C7 BA 03                           LD      R11, 03h(R10)                   ; reload loop counter from FREQ[3]
 1769/ AD5 : B9 18                              LD      LOOP1_CTR, R11
 1770/ AD7 : A2 B4                              CP      R11, ZERO                       ; counter == 0 → no iterations, skip to finalize
 1771/ AD9 : 6D 0C CC                           JP      Z, finalize_output.multiply
 1772/ ADC :                            .L_0ADC:                                ; called from: op_vibrato1($0ACE)
 1773/ ADC : 00 1B                              DEC     PROG_CTR                        ; DEC PROG_CTR (back up to re-read opcode on next pass)
 1774/ ADE : 00 18                              DEC     LOOP1_CTR                       ; DEC LOOP1_CTR
 1775/ AE0 : A4 E4 1C                           CP      BLOCK_CTR, ZERO                 ; BLOCK_CTR toggle state? 0 = use coeff2, else = use coeff1
 1776/ AE3 : 6B 06                              JR      Z, .vib1_use_coeff2
 1777/ AE5 : C7 CA 01                           LD      R12, 01h(R10)                   ; R12 = FREQ[1] (coefficient 1)
 1778/ AE8 : 8D 07 4D                           JP      multiply_8x16_r8r9              ; → multiply_8x16_r8r9 (R8:R9 *= R12)
 1779/ AEB :                            .vib1_use_coeff2:                                ; 1 refs
 1780/ AEB : C7 CA 02                           LD      R12, 02h(R10)                   ; R12 = FREQ[2] (coefficient 2)
 1781/ AEE : 8D 07 E9                           JP      multiply_acc_r8r9               ; → multiply_acc_r8r9 (R8:R9 += R12 × R8:R9)
