 2326/ E62 :                            synthesis_output:                                ; 1 refs
 2327/ E62 :                            ; synthesis_output: read param table and switch micro-op mode.
 2328/ E62 :                            ; Inputs:
 2329/ E62 :                            ;   R13 = param table index (from pitch_output, points to Synthesis output param table byte0)
 2330/ E62 :                            ;   R11 = fractional dither pattern (from pitch_output ROM[$0232+i])
 2331/ E62 :                            ;   R10 = multiply result magnitude (from R12 at pitch_output)
 2332/ E62 :                            ; ROM[$01:R13] = 3-byte entry: byte0=T (timer/freq step), byte1=micro-op, byte2=PRE0.
 2333/ E62 :                            ; 
 2334/ E62 :                            ; T byte determines which mode family the new sub belongs to:
 2335/ E62 :                            ;   T >= $40: oversampled modes (8x/4x/2x). Timer runs at T=$80.
 2336/ E62 :                            ;   T <  $40: direct 1x DDS mode ($C4). Timer runs at T=$01-$20.
 2337/ E62 :                            ; 
 2338/ E62 :                            ; UPPER PATH (T>=$40 → oversampled modes, sub 0-7):
 2339/ E62 :                            ;   Reads byte1 (new micro-op: $20/$82/$AC).
 2340/ E62 :                            ;   If reg[$1E]<$C4 (already oversampled): just update reg[$1E]. No R5 change.
 2341/ E62 :                            ;     The running chain picks up new reg[$1E] via LD R5,reg[$1E] at chain end.
 2342/ E62 :                            ;   If reg[$1E]>=$C4 (was 1x DDS): .switch_to_oversampling: DI, R14=R15=waveform[PHASE],
 2343/ E62 :                            ;     force R5 to new oversample chain. Safe transition: R14/R15 primed as samples.
 2344/ E62 :                            ; 
 2345/ E62 :                            ; LOWER PATH (T<$40 → 1x DDS, sub 8+):
 2346/ E62 :                            ;   If reg[$1E]>=$C4 (already 1x DDS): update R14=T (new freq step), update reg[$1E].
 2347/ E62 :                            ;     No R5 change needed — $C4 reloads R5 from reg[$1E] every IRQ4.
 2348/ E62 :                            ;   If reg[$1E]<$C4 (was oversampled): .switch_to_direct_sampling: DI, R14=T, force R5=$C4.
 2349/ E62 :                            ;     Chain transitions are safe: chain runs to last step before reading new reg[$1E].
 2350/ E62 :                            ;     Race only when R5=$19 (micro_init): sets R7=$40, then $C4 reads 40h($40)=CRASH.
 2351/ E62 :                            ;     See WIP_ocean_crash.md.
 2352/ E62 : 56 FA FD                           AND     0FAh, #0FDh                     ; 0FA=IRQ (interrupt request)
 2353/ E65 : CC 01                              LD      R12, #01h                       ; R12=$01: ROM high byte for param table at $01xx
 2354/ E67 : B9 FE                              LD      0FEh, R11                       ; 0FE=SPH (phase accumulator high)  ; save dither pattern to SPH — IRQ4 rotates SPH, carry dithers T0 ±1
 2355/ E69 : C2 BC                              LDC     R11, @RR12                      ; byte0 = T (timer reload for oversampled / freq step for 1x DDS)
 2356/ E6B : DE                                 INC     R13                             ; advance to byte1
 2357/ E6C : A6 EB 40                           CP      R11, #40h                       ; T >= $40? split oversampled vs 1x DDS
 2358/ E6F : 7B 11                              JR      C, .no_oversampling             ; T < $40 → 1x DDS path (sub 8+)
 2359/ E71 :                            .oversampling:
 2360/ E71 : C2 BC                              LDC     R11, @RR12                      ; byte1 = new oversample micro-op ($20/$82/$AC)
