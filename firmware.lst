 2255/ DF8 :                            finalize_output.pitch_output:                                ; 6 refs
 2256/ DF8 :                            ; Paths from finalize.envelope and finalize.pitch_acc_negative join herepitch_output: prepare synthesis_output parameters
 2257/ DF8 :                            ; Inputs: R12 = multiply result high (magnitude), R11 = low byte
 2258/ DF8 :                            ;         R13 = sub mode (from check_underflow/normalize/overflow)
 2259/ DF8 :                            ; R11 bits 7:5 select fractional freq dither pattern from ROM table at $0232.
 2260/ DF8 :                            ; Dither pattern stored in SPH, rotated each IRQ4 for sub-sample pitch accuracy.
 2261/ DF8 : AC 02                              LD      R10, #02h
 2262/ DFA : F0 EB                              SWAP    R11                             ; extract R11 bits 7:5: SWAP nibbles
 2263/ DFC : E0 EB                              RR      R11                             ; RR: bits 7:5 now at 2:0
 2264/ DFE : 56 EB 07                           AND     R11, #07h                       ; isolate 3-bit index (0-7)
 2265/ E01 : 06 EB 32                           ADD     R11, #32h                       ; table base $32 + index
 2266/ E04 : C2 BA                              LDC     R11, @RR10                      ; R11 = ROM[$0232+i] = fractional dither pattern (0-7 of 8 bits set)
 2267/ E06 :                            finalize_output.pitch_output.underflow_shift_entry:                                ; 1 refs
 2268/ E06 :                            ; 8th RR restores PITCH_ENV to original value after
 2269/ E06 :                            ; 7 RR's in pitch_acc_positive/overflow multiply. Needed when ECLK is
 2270/ E06 :                            ; already pending or bus not free (PITCH_ENV not refreshed from Port 1).
 2271/ E06 :                            ; Also entry from underflow_shift cap (R12=$1E, R11=0 = no dither).
 2272/ E06 : E0 1A                              RR      PITCH_ENV
