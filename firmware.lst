 2572/ D00 : C0 EA                              RRC     R10
 2573/ D02 : C0 EB                              RRC     R11
 2574/ D04 : E0 ED                              RR      R13                             ; coeff bit 4
 2575/ D06 : FB 04                              JR      NC, .mul_bit5
 2576/ D08 : 02 B9                              ADD     R11, ACC_LO
 2577/ D0A : 12 A8                              ADC     R10, ACC_HI
 2578/ D0C :                            .mul_bit5:                                ; 1 refs
 2579/ D0C : C0 EA                              RRC     R10
 2580/ D0E : C0 EB                              RRC     R11
 2581/ D10 : E0 ED                              RR      R13                             ; coeff bit 5
 2582/ D12 : FB 04                              JR      NC, .mul_bit6
 2583/ D14 : 02 B9                              ADD     R11, ACC_LO
 2584/ D16 : 12 A8                              ADC     R10, ACC_HI
 2585/ D18 :                            .mul_bit6:                                ; 1 refs
 2586/ D18 : C0 EA                              RRC     R10
 2587/ D1A : C0 EB                              RRC     R11
 2588/ D1C : E0 ED                              RR      R13                             ; coeff bit 6
 2589/ D1E : FB 04                              JR      NC, .mul_bit7
 2590/ D20 : 02 B9                              ADD     R11, ACC_LO
 2591/ D22 : 12 A8                              ADC     R10, ACC_HI
 2592/ D24 :                            .mul_bit7:                                ; 1 refs
 2593/ D24 : C0 EA                              RRC     R10
 2594/ D26 : C0 EB                              RRC     R11
 2595/ D28 : E0 ED                              RR      R13                             ; coeff bit 7 (PITCH_LO bit 7, last of low byte)
 2596/ D2A : FB 04                              JR      NC, .mul_bit8
 2597/ D2C : 02 B9                              ADD     R11, ACC_LO
 2598/ D2E : 12 A8                              ADC     R10, ACC_HI
 2599/ D30 :                            .mul_bit8:                                ; 1 refs
 2600/ D30 : C0 EA                              RRC     R10
 2601/ D32 : C0 EB                              RRC     R11
 2602/ D34 : E0 EC                              RR      R12                             ; coeff bit 8 (PITCH_HI bit 0)
 2603/ D36 : FB 04                              JR      NC, .mul_bit9
 2604/ D38 : 02 B9                              ADD     R11, ACC_LO
 2605/ D3A : 12 A8                              ADC     R10, ACC_HI
 2606/ D3C :                            .mul_bit9:                                ; 1 refs
 2607/ D3C : C0 EA                              RRC     R10
 2608/ D3E : C0 EB                              RRC     R11
 2609/ D40 : E0 EC                              RR      R12                             ; coeff bit 9
 2610/ D42 : FB 04                              JR      NC, .mul_bit10
 2611/ D44 : 02 B9                              ADD     R11, ACC_LO
 2612/ D46 : 12 A8                              ADC     R10, ACC_HI
 2613/ D48 :                            .mul_bit10:                                ; 1 refs
 2614/ D48 : C0 EA                              RRC     R10
 2615/ D4A : C0 EB                              RRC     R11
 2616/ D4C : E0 EC                              RR      R12                             ; coeff bit 10
 2617/ D4E : FB 04                              JR      NC, .mul_bit11
 2618/ D50 : 02 B9                              ADD     R11, ACC_LO
 2619/ D52 : 12 A8                              ADC     R10, ACC_HI
 2620/ D54 :                            .mul_bit11:                                ; 1 refs
 2621/ D54 : C0 EA                              RRC     R10
 2622/ D56 : C0 EB                              RRC     R11
 2623/ D58 :                            ; Coeff bit 11 = PITCH_HI bit 3 (integer bit, weight 1.0).
 2624/ D58 :                            ; Last iteration: adds ACC at FULL weight (no final RRC shift).
 2625/ D58 :                            ; With bit 11 set: result ≈ ACC × (1 + fraction). Can overflow if ACC is large.
 2626/ D58 :                            ; With bit 11 clear: result = ACC × fraction (< ACC). Never overflows.
 2627/ D58 :                            ; Carry from ADC = genuine overflow (result > 16 bits), NOT a sign test.
 2628/ D58 :                            ; With correct ACC base ($8000 ± noise), overflow should rarely fire.
 2629/ D58 : E0 EC                              RR      R12
 2630/ D5A : FB 04                              JR      NC, .mul_overflow_check         ; bit 11 clear → skip ADD, carry from previous RRC (not meaningful)
 2631/ D5C : 02 B9                              ADD     R11, ACC_LO                     ; bit 11 set → add ACC at weight 1.0 (result ≈ ACC × (1 + fraction))
 2632/ D5E : 12 A8                              ADC     R10, ACC_HI
 2633/ D60 :                            .mul_overflow_check:                                ; 1 refs
 2634/ D60 : 7D 0E CF                           JP      C, finalize.pitch_overflow      ; carry = overflow: result > 16 bits → pitch_overflow (halve + re-apply)
