  676/ 330 :                            ; ============================================================
  677/ 330 :                            ; === RAUD default — reload micro-program pointer + pitch envelope from slave RAM ($0330) ===
  678/ 330 :                            ; ============================================================
  679/ 330 :                                    ORG     0330h
  680/ 330 :                            .cmd_run_prog:
  681/ 330 :                            ; RAUD default path: called when cmd byte ($F8) has no command bits set.
  682/ 330 :                            ; This is the normal per-RAUD update during active synthesis.
  683/ 330 :                            ; 
  684/ 330 :                            ; Actions:
  685/ 330 :                            ;   1. Reload PROG_CTR from sram[source+1] (saved start position)
  686/ 330 :                            ;   2. Reload reg[$14:$15] from sram[$FE:$FF] (ACC2 pair)
  687/ 330 :                            ;   3. Read pitch envelope from COP via Port 3/Port 1 bus handshake
  688/ 330 :                            ;      (same EXSLA + PITCH_ENV update as op_lfsr_noise full_lfsr_step)
  689/ 330 :                            ;   4. Clear LOOP1_CTR, LOOP2_CTR, BLOCK_CTR (reset loop state)
  690/ 330 :                            ;   5. ADD PROG_CTR, #$1D (convert relative offset to register address)
  691/ 330 :                            ;   6. JP micro_program_interpreter (re-run from saved position)
  692/ 330 :                            ; 
  693/ 330 :                            ; The sram[source+1] value is written to $02 by irq3_first_time on the
  694/ 330 :                            ; first RAUD after full_setup. This points to byte[2] of the micro-program
  695/ 330 :                            ; (the first opcode, past the 2-byte header). So each RAUD re-executes
  696/ 330 :                            ; the entire micro-program from the start.
  697/ 330 :                            ; 
  698/ 330 :                            ; NOTE: PROG_CTR here is a RELATIVE offset (0-based into the program).
  699/ 330 :                            ; The ADD #$1D converts it to an absolute register-file address, since
  700/ 330 :                            ; micro-program bytes are stored in reg[$1D] onward after LDEI load.
  701/ 330 : BC F5                              LD      R11, #0F5h
  702/ 332 : 82 BA                              LDE     R11, @RR10                      ; R11 = sram[$F5] = micro-program source base (e.g., $D4)
  703/ 334 : BE                                 INC     R11                             ; INC R11 → point to sram[source+1] (saved PROG_CTR start)
  704/ 335 : 82 CA                              LDE     R12, @RR10                      ; R12 = sram[source+1] = saved start offset ($02 after first_time)
  705/ 337 : C9 1B                              LD      PROG_CTR, R12                   ; PROG_CTR = saved start offset (relative, before ADD #$1D)
  706/ 339 : BC FE                              LD      R11, #0FEh                      ; R11 = $FE (slave RAM address of reg[$14] init)
  707/ 33B : CC 14                              LD      R12, #14h                       ; R12 = $14 (destination register = ACC2_HI)
  708/ 33D : 83 CA                              LDEI    @R12, @RR10                     ; reg[$14] = sram[$FE] (ACC2_HI), R12→$15, R11→$FF
  709/ 33F : 83 CA                              LDEI    @R12, @RR10                     ; reg[$15] = sram[$FF] (ACC2_LO), R12→$16, R11→$00(wrap)
  710/ 341 : C8 E3                              LD      R12, PORT3                      ; R12 = Port 3 (EXSLA routing bits from master)
  711/ 343 : E6 F8 0C                           LD      0F8h, #0Ch                      ; 0F8=P01M (port 0/1 mode)  ; P01M = $0C (Port 0 = output, Port 1 = input; release data bus)
  712/ 346 : B6 E2 07                           XOR     PORT2, #07h                     ; XOR Port 2 (toggle bus handshake lines)
  713/ 349 : E6 F6 04                           LD      0F6h, #04h                      ; 0F6=P2M (port 2 mode / RARC)  ; P2M = $04 (RARC = input/high-Z; release bus to master)
  714/ 34C : 66 10 80                           TCM     MODE, #80h                      ; MODE bit 7: pitch envelope enable?
  715/ 34F : 6B 05                              JR      Z, .L_0356                      ; bit 7 SET (Z) → pitch tracking active: load PITCH_ENV + EXSLA
  716/ 351 : E6 1A 00                           LD      PITCH_ENV, #00h                 ; bit 7 CLEAR: fixed formant, no pitch modulation
  717/ 354 : 8B 12                              JR      .L_0368                         ; skip to loop counter reset
  718/ 356 :                            .L_0356:                                ; called from: .cmd_run_prog($034F)
  719/ 356 : E4 15 1A                           LD      PITCH_ENV, ACC2_LO              ; PITCH_ENV = ACC2_LO (pitch modulation depth from COP)
  720/ 359 : B0 15                              CLR     ACC2_LO                         ; clear ACC2_LO after consuming it
  721/ 35B : F0 EC                              SWAP    R12                             ; extract EXSLA routing: SWAP + RL + AND $C0 → bits [7:6]
  722/ 35D : 90 EC                              RL      R12
  723/ 35F : 56 EC C0                           AND     R12, #0C0h
  724/ 362 : 56 12 3F                           AND     PITCH_HI, #3Fh                  ; clear EXSLA bits in PITCH_HI (keep coeff bits [5:0])
  725/ 365 : 44 EC 12                           OR      PITCH_HI, R12                   ; merge new EXSLA bits [7:6] into PITCH_HI
  726/ 368 :                            .L_0368:                                ; called from: .cmd_run_prog($0354)
  727/ 368 : B0 18                              CLR     LOOP1_CTR                       ; clear loop counters (micro-program loops restart each RAUD)
  728/ 36A : B0 19                              CLR     LOOP2_CTR
  729/ 36C : 06 1B 1D                           ADD     PROG_CTR, #1Dh                  ; PROG_CTR += $1D → absolute register address (reg[$1F] for offset $02)
  730/ 36F : B0 1C                              CLR     BLOCK_CTR                       ; clear block counter (LFSR/repeat state resets each RAUD)
  731/ 371 : 8D 05 8E                           JP      micro_program_interpreter       ; restart micro-program interpreter from saved position
